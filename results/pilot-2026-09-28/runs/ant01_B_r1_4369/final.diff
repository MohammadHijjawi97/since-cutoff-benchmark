+import json
+
+import httpx2
+
+from anthropic import Anthropic
+
+from app.labeler import label_ticket
+
+bodies = []
+
+
+def handler(request):
+    bodies.append(json.loads(request.content))
+    return httpx2.Response(200, json={
+        "id": "msg_1", "type": "message", "role": "assistant", "model": "claude-sonnet-4-6",
+        "content": [{"type": "text", "text": " Feature\n"}],
+        "stop_reason": "end_turn", "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 1},
+    })
+
+
+client = Anthropic(api_key="x", http_client=httpx2.Client(transport=httpx2.MockTransport(handler)))
+print(label_ticket(client, "please add dark mode"), len(bodies), bodies[0])
