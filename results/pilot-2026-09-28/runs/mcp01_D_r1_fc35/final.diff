+import asyncio
+
+from mcp import Client
+
+from app.server import build_server
+
+
+async def main():
+    async with Client(build_server()) as c:
+        print([t.name for t in (await c.list_tools()).tools])
+        print(await c.call_tool("add_note", {"title": "a", "body": "one two  three\nfour"}))
+        print(await c.call_tool("word_count", {"title": "a"}))
+        print(await c.call_tool("word_count", {"title": "zzz"}))
+
+
+asyncio.run(main())
