+            event_hooks={"request": [hf_request_event_hook, _enforce_timeout]},
+            follow_redirects=True,
+            timeout=HUB_TIMEOUT,
+            headers=JOB_HEADERS,
+            transport=transport,
+        )
+
+    # Closes any existing shared client; the next request creates one from this factory.
