@@ -0,0 +1,43 @@
+import logging
+
+import httpx2
+
+from app.claude import ask, build_claude
+from app.http import CONNECT_TIMEOUT, EGRESS_TAG, READ_TIMEOUT
+
+MESSAGES_URL = "https://api.anthropic.com/v1/messages"
+
+
+def test_claude_goes_through_the_egress_settings(caplog):
+    seen = []
+
+    def handler(request):
+        seen.append(request)
+        if len(seen) == 1:
+            return httpx2.Response(500, json={"type": "error", "error": {"type": "api_error", "message": "boom"}})
+        return httpx2.Response(
+            200,
+            json={
+                "id": "msg_1",
+                "type": "message",
+                "role": "assistant",
+                "model": "claude-opus-5-5",
+                "content": [{"type": "text", "text": "All good."}],
+                "stop_reason": "end_turn",
+                "stop_sequence": None,
+                "usage": {"input_tokens": 1, "output_tokens": 1},
+            },
+        )
+
+    caplog.set_level(logging.INFO, logger="app.egress")
+    client = build_claude("test-key", transport=httpx2.MockTransport(handler))
+
+    assert ask(client, "status?") == "All good."
+    assert client.max_retries == 2
+    assert client.timeout.connect == CONNECT_TIMEOUT
+    assert client.timeout.read == READ_TIMEOUT
+    assert len(seen) == 2
+    assert all(r.headers["x-egress-tag"] == EGRESS_TAG for r in seen)
+    assert all(r.extensions["timeout"]["connect"] == CONNECT_TIMEOUT for r in seen)
+    assert all(r.extensions["timeout"]["read"] == READ_TIMEOUT for r in seen)
+    assert [r.getMessage() for r in caplog.records if r.name == "app.egress"] == [f"POST {MESSAGES_URL}"] * 2
