 import pandas as pd
 
 
+def _format_amount(value: object) -> str:
+    """Accounting style: "12,500.00", "(634.20)" for negatives, "-" for zero, "" for missing."""
+    if pd.isna(value):
+        return ""
+    amount = round(float(value), 2)
+    # Rounding first means float noise such as 1e-12 left over from summing shows as zero.
+    if amount == 0:
+        return "-"
+    text = f"{abs(amount):,.2f}"
+    return f"({text})" if amount < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Return a copy of the account x month table with every cell formatted as an accounting string."""
+    return table.map(_format_amount)
