+import json
+
+import httpx2 as httpx
+from anthropic import Anthropic
+
+from app.invoices import extract_invoice
+
+ROW = {"invoice_number": "A1", "vendor": "V", "issue_date": "2026-09-01", "currency": "EUR", "total": 12.5}
+seen = {}
+
+
+def handler(req):
+    seen["body"] = json.loads(req.content)
+    seen["beta"] = req.headers.get("anthropic-beta")
+    seen["url"] = str(req.url)
+    return httpx.Response(200, json={
+        "id": "msg_1", "type": "message", "role": "assistant", "model": "claude-opus-5-5",
+        "content": [{"type": "thinking", "thinking": "", "signature": "x"},
+                    {"type": "text", "text": json.dumps(ROW)}],
+        "stop_reason": "end_turn", "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 1},
+    })
+
+
+c = Anthropic(api_key="x", http_client=httpx.Client(transport=httpx.MockTransport(handler)))
+assert extract_invoice(c, "file_abc") == ROW
+print(seen["url"], seen["beta"])
+print(json.dumps(seen["body"], indent=1))
