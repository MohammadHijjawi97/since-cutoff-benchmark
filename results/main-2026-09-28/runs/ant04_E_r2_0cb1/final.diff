+        headers={"X-Egress-Tag": EGRESS_TAG},
+        event_hooks={"request": [log_egress]},
+        **client_kwargs,
+    )
+    return Anthropic(api_key=api_key, timeout=timeout, max_retries=2, http_client=http_client)
 
 
