 def build_claude(api_key: str, transport=None) -> Anthropic:
-    raise NotImplementedError
+    # The SDK is built on httpx2 and rejects the httpx client from build_http_client(), so apply
+    # the same egress settings to an httpx2 client. The SDK sends every attempt, retries included,
+    # through this client, so log_egress fires once per request.
+    timeout = Timeout(READ_TIMEOUT, connect=CONNECT_TIMEOUT)
