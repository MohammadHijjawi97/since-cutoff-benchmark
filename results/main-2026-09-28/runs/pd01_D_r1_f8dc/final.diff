 import pandas as pd
 
 
+def _strip(value):
+    return value.strip() if isinstance(value, str) else value
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A copy of ``df`` with text trimmed, blank text missing and missing qty 0."""
+    out = df.copy()
+    for col in out.columns:
+        s = out[col]
+        if isinstance(s.dtype, pd.StringDtype):
+            s = s.str.strip()
+        elif s.dtype == object:
+            # Mixed columns: only touch the actual strings.
+            s = s.map(_strip)
+        else:
+            continue
+        empty = (s == "").fillna(False).astype(bool)
+        out[col] = s.mask(empty)
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+    return out
