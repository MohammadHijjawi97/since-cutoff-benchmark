+        "temp_c": [np.nan, 1.0, 5.0, np.nan, np.nan, np.nan, np.nan, 7.0, np.nan],
+        "battery": [1, 2, 3, 4, 5, 6, 7, 8, 9],
+    },
+    index=[5, 5, 1, 2, 3, 4, 0, 9, 9],
+)
+orig = df.copy()
+out = fill_gaps(df)
+print(out)
+assert df.equals(orig)
+exp = pd.Series([5.0, 1.0, 5.0, np.nan, 1.0, 5.0, np.nan, 7.0, 1.0], index=df.index, name="temp_c")
+pd.testing.assert_series_equal(out["temp_c"], exp)
+pd.testing.assert_frame_equal(out.drop(columns="temp_c"), df.drop(columns="temp_c"))
+r = load_readings("tests/data/reports.csv")
