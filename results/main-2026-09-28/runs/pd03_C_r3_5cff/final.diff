@@ -6,4 +6,11 @@
 
 
 def fill_gaps(readings: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Fill missing ``temp_c`` from the same station: previous value first, else the next one."""
+    filled = readings.copy()
+    # Rows without a station id belong to no group: transform gives NaN for them, so only
+    # use it to fill gaps and never to overwrite an existing reading.
+    by_station = filled.groupby("station", sort=False)["temp_c"]
+    fills = by_station.transform(lambda temps: temps.ffill().bfill())
+    filled["temp_c"] = filled["temp_c"].fillna(fills)
+    return filled
