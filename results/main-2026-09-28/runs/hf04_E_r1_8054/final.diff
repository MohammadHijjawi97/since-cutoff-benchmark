+import logging
+
+import httpx2
+import pytest
+from huggingface_hub import HfApi
+from huggingface_hub.errors import RepositoryNotFoundError
+from huggingface_hub.utils import close_session
+
+from app.network import configure_hub_http, current_revision
+
+
+@pytest.fixture(autouse=True)
+def _reset_session():
+    yield
+    close_session()
+
+
+def test_requests_use_configured_client():
+    seen = []
+
+    def handler(request):
+        seen.append(request)
+        return httpx2.Response(200, json={"id": "acme-ml/ner-large", "sha": "abc123", "siblings": []})
+
+    configure_hub_http(transport=httpx2.MockTransport(handler))
+    assert current_revision("acme-ml/ner-large") == "abc123"
+    HfApi().model_info("acme-ml/ner-large")
+
+    assert len(seen) == 2
+    for request in seen:
+        assert request.headers["X-Acme-Job"] == "nightly-sync"
+        assert "hf_hub/" in request.headers["user-agent"]
+        assert request.extensions["timeout"] == {"connect": 5.0, "read": 60.0, "write": 60.0, "pool": 60.0}
+    assert seen[0].url.path.endswith("/revision/main")
+
+
+@pytest.mark.parametrize("error", [httpx2.ConnectError, httpx2.ReadTimeout, httpx2.ConnectTimeout])
+def test_unreachable_hub_returns_none(error, caplog):
+    def handler(request):
+        raise error("boom", request=request)
+
+    configure_hub_http(transport=httpx2.MockTransport(handler))
+    with caplog.at_level(logging.WARNING, logger="app.network"):
+        assert current_revision("acme-ml/ner-large") is None
+    assert [r.name for r in caplog.records if r.levelno == logging.WARNING] == ["app.network"]
+
+
+def test_missing_repo_raises():
+    def handler(request):
+        return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, json={"error": "not found"})
+
+    configure_hub_http(transport=httpx2.MockTransport(handler))
+    with pytest.raises(RepositoryNotFoundError):
+        current_revision("acme-ml/does-not-exist")
