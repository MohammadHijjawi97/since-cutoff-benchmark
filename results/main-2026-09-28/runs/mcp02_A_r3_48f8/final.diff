--- /dev/null
+++ b/_smoke.py
@@ -0,0 +1,42 @@
+import anyio
+from mcp.client.client import Client
+from mcp.server.mcpserver import MCPServer
+from mcp.server.mcpserver.exceptions import ToolError
+from opsbot.calls import run_tool, ToolCallFailed
+
+srv = MCPServer("t")
+
+
+@srv.tool()
+def status(service: str) -> dict:
+    return {"service": service, "up": True}
+
+
+@srv.tool()
+def zero() -> int:
+    return 0
+
+
+@srv.tool(structured_output=False)
+def hello(name: str) -> str:
+    return f"hi {name}"
+
+
+@srv.tool()
+def boom() -> str:
+    raise ToolError("no such version")
+
+
+async def main():
+    async with Client(srv) as c:
+        s = c.session
+        print(repr(await run_tool(s, "status", {"service": "api"})))
+        print(repr(await run_tool(s, "zero", {})))
+        print(repr(await run_tool(s, "hello", {"name": "x"})))
+        try:
+            await run_tool(s, "boom", {})
+        except ToolCallFailed as e:
+            print("raised:", repr(e.tool), repr(e.message))
+
+
+anyio.run(main)
