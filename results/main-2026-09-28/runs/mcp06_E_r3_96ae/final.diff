@@ -0,0 +1,45 @@
+import anyio
+from mcp.server import MCPServer
+from mcp.server.mcpserver.exceptions import ToolError
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+
+server = MCPServer("demo")
+
+
+@server.tool()
+def add(a: int, b: int) -> int:
+    return a + b
+
+
+@server.tool()
+def greet(name: str) -> str:
+    return f"Hello, {name}!"
+
+
+@server.tool()
+def fail() -> str:
+    raise ToolError("boom")
+
+
+def test_check_server_all_pass():
+    cases = [Case("add", {"a": 2, "b": 3}, "5"), Case("greet", {"name": "Ada"}, "Hello, Ada!")]
+    assert anyio.run(check_server, server, cases) == []
+
+
+def test_check_server_mismatches_in_order():
+    wrong_add = Case("add", {"a": 2, "b": 2}, "5")
+    ok = Case("greet", {"name": "Ada"}, "Hello, Ada!")
+    wrong_greet = Case("greet", {"name": "Bob"}, "Hi Bob")
+    assert anyio.run(check_server, server, [wrong_add, ok, wrong_greet]) == [
+        Mismatch(wrong_add, "4"),
+        Mismatch(wrong_greet, "Hello, Bob!"),
+    ]
+
+
+def test_check_server_tool_error_is_a_mismatch():
+    case = Case("fail", {}, "ok")
+    [mismatch] = anyio.run(check_server, server, [case])
+    assert mismatch.case == case
+    assert "boom" in mismatch.got
