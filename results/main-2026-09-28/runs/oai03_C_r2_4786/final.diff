 def answer(client: OpenAI, question: str, history: Iterable[tuple[str, str]] = ()) -> str:
-    """The complete answer to `question` (used by the e-mail channel)."""
-    raise NotImplementedError
+    """The complete answer to `question` (used by the e-mail channel).
+
+    A failed or dropped connection restarts the whole request, up to ATTEMPTS times;
+    a read timeout is not retried.
+    """
+    history = list(history)  # may be a one-shot iterator, and each attempt needs it
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            return "".join(iter_answer(client, question, history))
+        except APITimeoutError as err:  # subclass of APIConnectionError, so check it first
+            raise UpstreamTimeout(_network_message(err)) from err
+        except APIConnectionError as err:
+            logger.warning("Attempt %d/%d to reach the model failed: %s", attempt, ATTEMPTS, _network_message(err))
+            last_error = err
+    raise UpstreamUnavailable(f"No answer after {ATTEMPTS} attempts: {_network_message(last_error)}") from last_error
+
+
+def _network_message(err: APIConnectionError) -> str:
+    """The underlying network error's message; openai's own is just "Connection error."."""
+    cause = err.__cause__
+    return f"{type(cause).__name__}: {cause}" if cause is not None else str(err)
