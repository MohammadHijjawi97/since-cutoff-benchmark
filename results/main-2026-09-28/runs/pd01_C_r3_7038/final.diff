+import pandas as pd
+from app.clean import clean_orders
+from app.load import load_orders
+
+
+def test_csv(tmp_path):
+    p = tmp_path / "o.csv"
+    p.write_text("sku,qty,note,price\n A1 ,2, hi ,1.5\n  ,, ,2\nB2,3,,\n")
+    df = load_orders(p)
+    before = df.copy()
+    out = clean_orders(df)
+    print(df.dtypes, out.dtypes, out, sep="\n")
+    pd.testing.assert_frame_equal(df, before)
+    assert out["sku"].tolist()[0] == "A1"
+    assert out["sku"].isna().tolist() == [False, True, False]
+    assert out["note"].tolist()[0] == "hi"
+    assert out["note"].isna().tolist() == [False, True, True]
+    assert out["qty"].tolist() == [2, 0, 3]
+    assert out["price"].isna().tolist() == [False, False, True]
+
+
+def test_object_mixed():
+    df = pd.DataFrame({"sku": pd.Series([" x", 5, None, "  "], dtype=object), "qty": [1, None, 2, 3]})
+    before = df.copy()
+    out = clean_orders(df)
+    print(out)
+    pd.testing.assert_frame_equal(df, before)
+    assert out["sku"].tolist()[:2] == ["x", 5]
+    assert out["sku"].isna().tolist() == [False, False, True, True]
+    assert out["qty"].tolist() == [1, 0, 2, 3]
