+import logging
+
+import httpx2
+
+from app.network import configure_hub_http, current_revision
+from huggingface_hub import errors
+
+logging.basicConfig()
+seen = []
+
+
+def handler(req):
+    seen.append(req)
+    if "missing" in str(req.url):
+        return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, json={"error": "nf"})
+    if "down" in str(req.url):
+        raise httpx2.ConnectError("boom", request=req)
+    if "slow" in str(req.url):
+        raise httpx2.ReadTimeout("slow", request=req)
+    return httpx2.Response(200, json={"id": "a/b", "sha": "deadbeef", "private": False, "tags": [], "siblings": []})
+
+
+configure_hub_http(httpx2.MockTransport(handler))
+print(current_revision("a/b"), seen[-1].url)
+r = seen[-1]
+print(r.headers["x-acme-job"], r.headers["user-agent"][:40], r.extensions["timeout"])
+print(current_revision("a/down"), current_revision("a/slow"))
+try:
+    current_revision("a/missing")
+except errors.RepositoryNotFoundError as e:
+    print("raised", type(e).__name__)
