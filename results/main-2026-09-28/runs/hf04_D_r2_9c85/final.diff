+def _apply_timeout(request: httpx2.Request) -> None:
+    # HfApi methods pass `timeout=None` explicitly, which httpx2 turns into "no timeout at all"
+    # and which would bypass the client default. Put our timeouts back on those requests.
+    timeout = request.extensions.get("timeout")
+    if timeout is None or all(value is None for value in timeout.values()):
+        request.extensions["timeout"] = TIMEOUT.as_dict()
+
+
+async def _async_apply_timeout(request: httpx2.Request) -> None:
+    _apply_timeout(request)
+
 
