+
+def _network_error_message(err: APIConnectionError) -> str:
+    """The underlying network error's message (the SDK's own is just "Connection error.")."""
+    cause = err.__cause__
+    if cause is None:
+        return str(err)
+    return str(cause) or type(cause).__name__
