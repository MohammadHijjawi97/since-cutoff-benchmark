+    """The complete answer to `question` (used by the e-mail channel).
+
+    A failed or dropped connection restarts the request from scratch, up to ATTEMPTS
+    times; a timeout is not retried.
+    """
+    history = list(history)  # may be a one-shot iterable; every attempt needs it
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            return "".join(iter_answer(client, question, history))
+        except APITimeoutError as err:
+            raise UpstreamTimeout(_network_error_message(err)) from err
+        except APIConnectionError as err:
+            logger.warning(
+                "Answer attempt %d/%d failed: %s", attempt, ATTEMPTS, _network_error_message(err)
+            )
+            last_error = err
+    raise UpstreamUnavailable(f"No complete answer after {ATTEMPTS} attempts") from last_error
