+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.documents import Document
+
+from app.context import MAX_SOURCES, TRACE_TAG, build_context
+from app.kb import KeywordRetriever
+
+
+class TagRecorder(BaseCallbackHandler):
+    def __init__(self):
+        self.tags = None
+
+    def on_retriever_start(self, serialized, query, *, tags=None, **kwargs):
+        self.tags = tags
+
+
+def make_retriever():
+    sources = ["a.md", "a.md", "b.md", "c.md", "d.md"]
+    docs = [
+        Document(page_content=f"\n  vpn note {i}  \n", metadata={"source": source})
+        for i, source in enumerate(sources)
+    ]
+    return KeywordRetriever(docs=docs, k=len(docs))
+
+
+def test_one_entry_per_source_capped_and_numbered():
+    assert MAX_SOURCES == 3
+    assert build_context(make_retriever(), "vpn") == (
+        "[1] a.md\nvpn note 0\n\n[2] b.md\nvpn note 2\n\n[3] c.md\nvpn note 3"
+    )
+
+
+def test_nothing_found_gives_empty_string():
+    assert build_context(make_retriever(), "kubernetes") == ""
+
+
+def test_lookup_carries_trace_tag():
+    recorder = TagRecorder()
+    build_context(make_retriever().with_config(callbacks=[recorder]), "vpn")
+    assert TRACE_TAG in recorder.tags
