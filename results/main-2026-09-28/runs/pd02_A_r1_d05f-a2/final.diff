 import pandas as pd
 
 
+def _accounting(value: object) -> str:
+    """Format one amount in accounting style: "12,500.00", "(634.20)", "-" for zero, "" for missing."""
+    if pd.isna(value):
+        return ""
+    amount = float(value)
+    text = f"{abs(amount):,.2f}"
+    # Compare after rounding to cents so float noise such as 1e-13 or -0.0 shows as zero.
+    if text == "0.00":
+        return "-"
+    return f"({text})" if amount < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
