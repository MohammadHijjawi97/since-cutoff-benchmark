@@ -0,0 +1,19 @@
+import httpx2
+import openai
+import pytest
+
+from tests.fakes import mock_openai
+
+
+def test_extra():
+    pre = openai.OpenAI(api_key="x", max_retries=0)
+    with mock_openai("a") as seen:
+        inside = openai.OpenAI(api_key="x", max_retries=0)
+        assert pre.chat.completions.create(model="m", messages=[]).choices[0].message.content == "a"
+        with pytest.raises(openai.BadRequestError):
+            inside.chat.completions.create(model="m", messages=[])
+    assert len(seen) == 2
+    assert httpx2.Client._transport_for_url.__qualname__ == "Client._transport_for_url"
+    with pytest.raises(Exception, match="socket"):
+        pre.chat.completions.create(model="m", messages=[])
+    assert len(seen) == 2
