--- a/app/labeler.py
+++ b/app/labeler.py
@@ -6,5 +6,22 @@
 MODEL = "claude-sonnet-4-6"
 
 
+SYSTEM_PROMPT = (
+    "Classify the support ticket. Answer with exactly one word from: "
+    + ", ".join(LABELS)
+    + "."
+)
+
+
 def label_ticket(client: Anthropic, text: str) -> str:
-    raise NotImplementedError
+    response = client.messages.create(
+        model=MODEL,
+        max_tokens=5,
+        system=SYSTEM_PROMPT,
+        messages=[{"role": "user", "content": text}],
+        # anthropic 1.x dropped the `temperature` kwarg; send it in the body.
+        extra_body={"temperature": 0},
+    )
+    reply = "".join(b.text for b in response.content if b.type == "text")
+    label = reply.strip().lower()
+    return label if label in LABELS else "question"
