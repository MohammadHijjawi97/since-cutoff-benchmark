@@ -6,5 +6,21 @@
 MODEL = "claude-sonnet-4-6"
 
 
+SYSTEM_PROMPT = (
+    "Classify the support ticket. Answer with exactly one word from this list: "
+    + ", ".join(LABELS)
+    + "."
+)
+
+
 def label_ticket(client: Anthropic, text: str) -> str:
-    raise NotImplementedError
+    """One of LABELS; falls back to "question" on any unexpected reply."""
+    message = client.messages.create(
+        model=MODEL,
+        max_tokens=5,
+        temperature=0,
+        system=SYSTEM_PROMPT,
+        messages=[{"role": "user", "content": text}],
+    )
+    label = "".join(block.text for block in message.content if block.type == "text").strip().lower()
+    return label if label in LABELS else "question"
