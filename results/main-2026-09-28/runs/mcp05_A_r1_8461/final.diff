--- /dev/null
+++ b/_e2e_check.py
@@ -0,0 +1,44 @@
+import anyio
+import uvicorn
+from mcp.server.mcpserver import MCPServer
+from starlette.responses import PlainTextResponse
+
+from kb.remote import search_remote
+
+server = MCPServer("kb")
+seen = []
+
+
+@server.tool()
+def search(query: str) -> str:
+    return f"Result for {query}\n\nOnboarding\n"
+
+
+inner = server.streamable_http_app()
+
+
+async def app(scope, receive, send):
+    if scope["type"] == "http":
+        headers = dict(scope["headers"])
+        auth = headers.get(b"authorization")
+        seen.append((scope["method"], auth))
+        if auth != b"Bearer s3cret":
+            await PlainTextResponse("no", status_code=401)(scope, receive, send)
+            return
+    await inner(scope, receive, send)
+
+
+async def main():
+    config = uvicorn.Config(app, host="127.0.0.1", port=8765, log_level="warning")
+    srv = uvicorn.Server(config)
+    async with anyio.create_task_group() as tg:
+        tg.start_soon(srv.serve)
+        while not srv.started:
+            await anyio.sleep(0.05)
+        print(await search_remote("http://127.0.0.1:8765/mcp", "s3cret", "keys"))
+        await anyio.sleep(0.3)
+        srv.should_exit = True
+    print(seen)
+
+
+anyio.run(main)
