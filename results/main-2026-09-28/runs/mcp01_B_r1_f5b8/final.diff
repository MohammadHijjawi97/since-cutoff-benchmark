+import asyncio, sys
+from mcp import ClientSession, StdioServerParameters
+from mcp.client.stdio import stdio_client
+
+async def main():
+    p = StdioServerParameters(command=sys.executable, args=["-m", "app.server"])
+    async with stdio_client(p) as (r, w), ClientSession(r, w) as s:
+        await s.initialize()
+        print([t.name for t in (await s.list_tools()).tools])
+        print(await s.call_tool("add_note", {"title": "a", "body": "one two  three\nfour"}))
+        print(await s.call_tool("word_count", {"title": "a"}))
+        print(await s.call_tool("word_count", {"title": "zzz"}))
+asyncio.run(main())
