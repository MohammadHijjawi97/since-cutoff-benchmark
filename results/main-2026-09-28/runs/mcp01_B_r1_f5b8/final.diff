+        return f"saved {title}"
+
+    @server.tool()
+    def word_count(title: str) -> int:
+        """Return the number of whitespace-separated words in a stored note."""
+        if title not in NOTES:
+            # ToolError's message reaches the client; other exceptions are masked.
+            raise ToolError(f"no such note: {title!r}")
+        return len(NOTES[title].split())
