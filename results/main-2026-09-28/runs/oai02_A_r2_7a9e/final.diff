+@contextmanager
+def _route_httpx2_through(router: respx.Router) -> Iterator[None]:
+    """Send every request of a synchronous httpx2 transport to `router` while active.
+
+    openai>=3 sends its requests with httpx2, which respx does not patch: respx only covers
+    `httpx`, which openai still accepts as a custom `http_client`. Patching the transport class
+    (not an instance) also covers clients created before the block, such as app.digest's cached
+    one. Requests the router does not match raise respx's AllMockedAssertionError, as with httpx.
+    """
+
+    def handle_request(transport: httpx2.HTTPTransport, request: httpx2.Request) -> httpx2.Response:
+        response = router.handler(
+            httpx.Request(request.method, str(request.url), headers=request.headers.raw, content=request.read())
+        )
+        return httpx2.Response(response.status_code, headers=response.headers.raw, content=response.read())
+
+    with mock.patch.object(httpx2.HTTPTransport, "handle_request", handle_request):
+        yield
