--- /dev/null
+++ b/_scratch_client.py
@@ -0,0 +1,19 @@
+import sys
+
+import anyio
+
+from opsbot.calls import ToolCallFailed, run_tool
+from opsbot.connection import open_session
+
+
+async def main() -> None:
+    async with open_session([sys.executable, "_scratch_server.py"]) as s:
+        print("status:", repr(await run_tool(s, "status", {"service": "api"})))
+        print("echo:", repr(await run_tool(s, "echo", {"text": "hi"})))
+        try:
+            await run_tool(s, "boom", {"reason": "no such version"})
+        except ToolCallFailed as exc:
+            print("boom raised:", exc.tool, "|", exc.message)
+
+
+anyio.run(main)
--- /dev/null
+++ b/_scratch_server.py
@@ -0,0 +1,22 @@
+from mcp.server import MCPServer
+
+app = MCPServer("scratch")
+
+
+@app.tool()
+def status(service: str) -> dict:
+    return {"service": service, "up": True}
+
+
+@app.tool()
+def echo(text: str) -> str:
+    return text
+
+
+@app.tool()
+def boom(reason: str) -> str:
+    raise ValueError(reason)
+
+
+if __name__ == "__main__":
+    app.run()
