+import asyncio
+import json
+
+import httpx2
+from anthropic import AsyncAnthropic
+
+from app import worker
+
+calls = []
+
+
+def handler(request):
+    calls.append(json.loads(request.content))
+    body = {
+        "id": "msg_1", "type": "message", "role": "assistant", "model": worker.MODEL,
+        "content": [{"type": "text", "text": "billing: refund request"}],
+        "stop_reason": "end_turn", "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 1},
+    }
+    return httpx2.Response(200, json=body, headers={worker.TOKENS_REMAINING: "1500", "request-id": "req_1"})
+
+
+def test_triage():
+    client = AsyncAnthropic(api_key="x", http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handler)))
+    out = asyncio.run(worker.triage(client, "charged twice"))
+    assert out == {"answer": "billing: refund request", "tokens_remaining": 1500, "request_id": "req_1", "throttle": True}
+    assert len(calls) == 1
+    assert calls[0]["max_tokens"] == 512 and calls[0]["system"] == worker.SYSTEM
+    assert calls[0]["messages"] == [{"role": "user", "content": "charged twice"}]
