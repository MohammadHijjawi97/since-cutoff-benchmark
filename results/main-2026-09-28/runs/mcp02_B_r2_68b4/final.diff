@@ -0,0 +1,31 @@
+import anyio
+import pytest
+from mcp.types import CallToolResult, ImageContent, TextContent
+
+from opsbot.calls import ToolCallFailed, run_tool
+
+
+class Stub:
+    def __init__(self, result):
+        self.result = result
+
+    async def call_tool(self, name, arguments):
+        return self.result
+
+
+def t(s):
+    return TextContent(type="text", text=s)
+
+
+def call(result):
+    return anyio.run(run_tool, Stub(result), "deploy", {})
+
+
+def test_all():
+    img = ImageContent(type="image", data="", mime_type="image/png")
+    assert call(CallToolResult(content=[t("a"), img, t("b")])) == "a\nb"
+    assert call(CallToolResult(content=[t("x")], structured_content={"k": 1})) == {"k": 1}
+    assert call(CallToolResult(content=[t("x")], structured_content=0)) == 0
+    with pytest.raises(ToolCallFailed) as ei:
+        call(CallToolResult(content=[t("no such"), t("version")], structured_content={"k": 1}, is_error=True))
+    assert ei.value.message == "no such\nversion"
