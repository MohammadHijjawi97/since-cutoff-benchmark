--- /dev/null
+++ b/_e2e_check.py
@@ -0,0 +1,42 @@
+import anyio
+from mcp import Client
+from mcp.server.mcpserver import MCPServer
+
+from opsbot.calls import ToolCallFailed, run_tool
+
+srv = MCPServer("t")
+
+
+@srv.tool(structured_output=True)
+def status(service: str) -> dict[str, object]:
+    return {"service": service, "up": True}
+
+
+@srv.tool(structured_output=True)
+def empty() -> dict[str, object]:
+    return {}
+
+
+@srv.tool(structured_output=False)
+def echo(msg: str) -> str:
+    return msg
+
+
+@srv.tool()
+def boom() -> str:
+    raise ValueError("no such version")
+
+
+async def main():
+    async with Client(srv) as c:
+        s = c.session
+        print(repr(await run_tool(s, "status", {"service": "api"})))
+        print(repr(await run_tool(s, "empty", {})))
+        print(repr(await run_tool(s, "echo", {"msg": "hi"})))
+        try:
+            await run_tool(s, "boom", {})
+        except ToolCallFailed as e:
+            print("failed:", e.tool, repr(e.message))
+
+
+anyio.run(main)
