+
+
+class RecordingRunApi:
+    def __init__(self):
+        self.calls = []
+
+    def create_repo(self, repo_id, **kwargs):
+        self.calls.append(("create_repo", repo_id, kwargs))
+
+    def upload_folder(self, **kwargs):
+        self.calls.append(("upload_folder", kwargs))
+
+
+def test_publish_run_creates_private_repo_and_uploads_folder(tmp_path):
+    api = RecordingRunApi()
+
+    publish_run(tmp_path, "acme-ml/run-0007", api=api)
+
+    (create, upload) = api.calls
+    assert create == ("create_repo", "acme-ml/run-0007", {"repo_type": "dataset", "private": True, "exist_ok": True})
+    kwargs = upload[1]
+    assert upload[0] == "upload_folder"
+    assert kwargs["repo_id"] == "acme-ml/run-0007" and kwargs["repo_type"] == "dataset"
+    assert kwargs["folder_path"] == tmp_path
+    assert kwargs.get("path_in_repo") is None
+    assert set(kwargs["ignore_patterns"]) == {"*.tmp", "wandb/*"}
+
+
+def test_run_ignore_patterns_skip_tmp_and_wandb():
+    paths = ["ckpt/step-100/model.safetensors", "ckpt/step-100/model.safetensors.tmp", "x.tmp",
+             "wandb/run-1/files/output.log", "data/shard-00001.parquet", "metrics.jsonl"]
+    kept = list(filter_repo_objects(paths, ignore_patterns=RUN_IGNORE_PATTERNS))
+    assert kept == ["ckpt/step-100/model.safetensors", "data/shard-00001.parquet", "metrics.jsonl"]
