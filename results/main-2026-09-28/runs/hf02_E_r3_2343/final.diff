-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+RUN_IGNORE_PATTERNS = ["*.tmp", "wandb/*"]  # fnmatch `*` also matches `/`, so these cover nested paths
+
+
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Upload the whole `run_dir` to the root of the private dataset repo `repo_id`, creating it if needed.
+
+    `upload_folder` (with hf_xet) streams large folders in several commits and resumes an interrupted upload
+    when re-run: files already committed on the Hub are skipped.
+    """
+    api = api or HfApi()
+    run_dir = Path(run_dir)
+    api.create_repo(repo_id, repo_type="dataset", private=True, exist_ok=True)
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=run_dir,
+        ignore_patterns=list(RUN_IGNORE_PATTERNS),
+        commit_message=f"Upload run {run_dir.name}",
+    )
