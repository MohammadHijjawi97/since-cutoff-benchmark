+import asyncio
+
+import httpx2
+from anthropic import AsyncAnthropic
+
+from app.worker import triage
+
+calls = []
+
+
+def handler(request):
+    calls.append(request)
+    return httpx2.Response(
+        200,
+        headers={"anthropic-ratelimit-tokens-remaining": "1500", "request-id": "req_1"},
+        json={
+            "id": "m", "type": "message", "role": "assistant", "model": "x",
+            "content": [{"type": "text", "text": "billing: refund"}],
+            "stop_reason": "end_turn", "stop_sequence": None,
+            "usage": {"input_tokens": 1, "output_tokens": 1},
+        },
+    )
+
+
+client = AsyncAnthropic(api_key="k", http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handler)))
+print(asyncio.run(triage(client, "charged twice")))
+print("requests:", len(calls), calls[0].content.decode())
