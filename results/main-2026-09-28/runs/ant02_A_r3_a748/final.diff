--- /dev/null
+++ b/_scratch_check.py
@@ -0,0 +1,38 @@
+import json
+
+import httpx2
+from anthropic import Anthropic, DefaultHttpxClient
+
+from app.audit import ask_with_audit
+
+body = json.dumps(
+    {
+        "id": "msg_1", "type": "message", "role": "assistant", "model": "claude-opus-5-5",
+        "content": [
+            {"type": "thinking", "thinking": "", "signature": "s"},
+            {"type": "text", "text": "Hello "},
+            {"type": "text", "text": "world"},
+        ],
+        "stop_reason": "end_turn", "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 2},
+    },
+    separators=(",", ":"),
+)
+seen = {}
+
+
+def handler(req):
+    seen.update(json.loads(req.content))
+    return httpx2.Response(
+        200, headers={"request-id": "req_abc", "content-type": "application/json"}, text=body
+    )
+
+
+client = Anthropic(api_key="x", http_client=DefaultHttpxClient(transport=httpx2.MockTransport(handler)))
+result = ask_with_audit(client, "hi")
+print(seen)
+print(result)
+assert result["raw_body"] == body
+assert result["request_id"] == "req_abc"
+assert result["answer"] == "Hello world"
+print("OK")
