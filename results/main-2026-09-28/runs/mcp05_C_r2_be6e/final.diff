--- /dev/null
+++ b/_e2e_kb.py
@@ -0,0 +1,33 @@
+import threading, time, anyio, uvicorn
+from mcp.server import MCPServer
+from kb.remote import search_remote
+
+srv = MCPServer("kb")
+
+
+@srv.tool()
+def search(query: str) -> str:
+    return f"Title A for {query}\n\nTitle B\n"
+
+
+inner = srv.streamable_http_app()
+seen = []
+
+
+async def app(scope, receive, send):
+    if scope["type"] == "http":
+        auth = dict(scope["headers"]).get(b"authorization")
+        seen.append((scope["method"], auth))
+        if auth != b"Bearer s3cret":
+            await send({"type": "http.response.start", "status": 401, "headers": []})
+            await send({"type": "http.response.body", "body": b""})
+            return
+    await inner(scope, receive, send)
+
+
+server = uvicorn.Server(uvicorn.Config(app, port=8765, log_level="warning"))
+threading.Thread(target=server.run, daemon=True).start()
+time.sleep(2)
+print(anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "s3cret", "vpn"))
+print(seen)
+server.should_exit = True
