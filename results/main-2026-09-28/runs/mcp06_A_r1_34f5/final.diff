@@ -0,0 +1,62 @@
+import sys
+import textwrap
+
+import anyio
+from mcp.server.mcpserver import MCPServer
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+from mcpcheck.stdio import check_command
+
+SERVER_SOURCE = textwrap.dedent(
+    """
+    from mcp.server.mcpserver import MCPServer
+
+    server = MCPServer("demo")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"Hello, {name}!"
+
+    @server.tool()
+    def boom() -> str:
+        raise ValueError("kaboom")
+    """
+)
+
+CASES = [
+    Case("add", {"a": 2, "b": 3}, "5"),
+    Case("greet", {"name": "Ada"}, "Hi Ada"),
+    Case("boom", {}, "ok"),
+    Case("add", {"a": 1, "b": 1}, "3"),
+    Case("greet", {"name": "Bob"}, "Hello, Bob!"),
+]
+
+
+def build_server() -> MCPServer:
+    namespace: dict = {}
+    exec(SERVER_SOURCE, namespace)
+    return namespace["server"]
+
+
+def test_check_server_reports_mismatches_in_order():
+    mismatches = anyio.run(check_server, build_server(), CASES)
+    assert [m.case for m in mismatches] == [CASES[1], CASES[2], CASES[3]]
+    assert mismatches[0] == Mismatch(CASES[1], "Hello, Ada!")
+    assert mismatches[2] == Mismatch(CASES[3], "2")
+
+
+def test_check_server_all_pass():
+    assert anyio.run(check_server, build_server(), [CASES[0], CASES[4]]) == []
+
+
+def test_check_server_matches_stdio(tmp_path):
+    script = tmp_path / "server.py"
+    script.write_text(SERVER_SOURCE + "\nserver.run()\n")
+    over_stdio = anyio.run(check_command, [sys.executable, str(script)], CASES)
+    in_process = anyio.run(check_server, build_server(), CASES)
+    assert in_process == over_stdio
