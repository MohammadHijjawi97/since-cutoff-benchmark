+from huggingface_hub import HfApi, constants
 
 SUMMARIES_REPO = "acme-ml/run-summaries"  # dataset repo with one summary.json per run
 
@@ -21,5 +22,25 @@
     return info.commit_url
 
 
-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+RUN_IGNORE_PATTERNS = ["*.tmp", "wandb/*"]
+
+
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`, skipping temp files and `wandb/`.
+
+    With `hf_xet` installed, `upload_folder` splits large folders into several commits and resumes an
+    interrupted upload when called again (already-committed files are skipped). Without it, it falls back
+    to a single huge commit, so we refuse to run rather than fail halfway through a big run.
+    """
+    if constants.HF_HUB_DISABLE_XET or importlib.util.find_spec("hf_xet") is None:
+        raise RuntimeError("publish_run needs hf_xet for resumable multi-commit uploads (is HF_HUB_DISABLE_XET set?)")
+    api = api or HfApi()
+    run_dir = Path(run_dir)
+    api.create_repo(repo_id, repo_type="dataset", private=True, exist_ok=True)
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=run_dir,
+        ignore_patterns=list(RUN_IGNORE_PATTERNS),
+        commit_message=f"Upload run {run_dir.name}",
+    )
