+def test_publish_run_creates_private_repo_then_uploads_folder_at_root(tmp_path):
+    api = RecordingApi()
+
+    publish_run(tmp_path, "acme-ml/run-0007", api=api)
+
+    create, upload = api.calls
+    assert create["method"] == "create_repo" and create["repo_id"] == "acme-ml/run-0007"
+    assert create["repo_type"] == "dataset" and create["private"] is True and create["exist_ok"] is True
+    assert upload["method"] == "upload_folder" and upload["repo_id"] == "acme-ml/run-0007"
+    assert upload["repo_type"] == "dataset" and upload["folder_path"] == tmp_path
+    assert upload.get("path_in_repo") in (None, "")
+
+
+def test_run_ignore_patterns_skip_tmp_files_and_wandb():
