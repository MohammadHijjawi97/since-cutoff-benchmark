+def test_publish_run_mirrors_folder_into_private_dataset_repo(tmp_path):
+    from huggingface_hub.utils import filter_repo_objects
+
+    run = tmp_path / "run-0007"
+    api = RecordingApi()
+
+    publish_run(run, "acme-ml/run-0007", api=api)
+
+    (repo_call,) = api.repo_calls
+    assert repo_call == {"repo_id": "acme-ml/run-0007", "repo_type": "dataset", "private": True, "exist_ok": True}
+    (call,) = api.folder_calls
+    assert call["repo_id"] == "acme-ml/run-0007" and call["repo_type"] == "dataset"
+    assert call["folder_path"] == run and call.get("path_in_repo") is None
+
+    paths = ["ckpt/step-100/model.safetensors", "ckpt/partial.tmp", "metrics.jsonl", "wandb/run/log.txt", "shards/a.tmp"]
