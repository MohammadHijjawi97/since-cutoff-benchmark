 import pandas as pd
 
 
+def _format_amount(value: float) -> str:
+    """Accounting style: 12,500.00, negatives as (634.20), zero as -, missing as empty."""
+    if pd.isna(value):
+        return ""
+    # Round first so amounts that display as 0.00 (e.g. -0.001, or -0.0) are shown as zero.
+    value = round(float(value), 2)
+    if value == 0:
+        return "-"
+    text = f"{abs(value):,.2f}"
+    return f"({text})" if value < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
