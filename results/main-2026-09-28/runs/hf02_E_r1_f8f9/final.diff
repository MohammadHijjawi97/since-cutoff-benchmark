+def test_publish_run_creates_private_dataset_repo_then_uploads_the_folder(tmp_path):
+    api = RecordingApi()
+
+    publish_run(tmp_path, "acme-ml/run-0007", api=api)
+
+    (create_name, create), (upload_name, upload) = api.calls
+    assert create_name == "create_repo" and upload_name == "upload_folder"
+    assert create == {"repo_id": "acme-ml/run-0007", "repo_type": "dataset", "private": True, "exist_ok": True}
+    assert upload["repo_id"] == "acme-ml/run-0007" and upload["repo_type"] == "dataset"
+    assert upload["folder_path"] == tmp_path
+    assert upload.get("path_in_repo") in (None, "")
+
+
+def test_publish_run_skips_tmp_files_and_wandb(tmp_path):
+    api = RecordingApi()
+    publish_run(tmp_path, "acme-ml/run-0007", api=api)
+    (_, upload) = api.calls[1]
+    paths = [
+        "metrics.json",
+        "ckpt/step-100/model.safetensors",
+        "ckpt/step-200/model.safetensors.tmp",
+        "shard.tmp",
+        "wandb/run-1/files/output.log",
+        "data/shard-00001.parquet",
+    ]
+
+    kept = list(filter_repo_objects(paths, ignore_patterns=upload["ignore_patterns"]))
+
+    assert kept == ["metrics.json", "ckpt/step-100/model.safetensors", "data/shard-00001.parquet"]
