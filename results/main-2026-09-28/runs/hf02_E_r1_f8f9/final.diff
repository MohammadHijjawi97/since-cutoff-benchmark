 """Publish training-run outputs to the Hugging Face Hub."""
 
+import importlib.util
 from pathlib import Path
 
 from huggingface_hub import HfApi
@@ -21,5 +22,22 @@
     return info.commit_url
 
 
-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`, skipping `*.tmp` and `wandb/`.
+
+    With hf_xet installed, `upload_folder` splits large folders into several commits and, when re-run after an
+    interruption, skips files already committed and deduplicates data already uploaded.
+    """
+    if importlib.util.find_spec("hf_xet") is None:
+        # Without hf_xet, upload_folder falls back to a single, non-resumable commit.
+        raise RuntimeError("publish_run needs hf_xet to upload large run folders resumably")
+    api = api or HfApi()
+    run_dir = Path(run_dir)
+    api.create_repo(repo_id=repo_id, repo_type="dataset", private=True, exist_ok=True)
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=run_dir,
+        ignore_patterns=["*.tmp", "wandb/"],
+        commit_message=f"Upload run {run_dir.name}",
+    )
