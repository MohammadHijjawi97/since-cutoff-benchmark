--- /dev/null
+++ b/_e2e_check.py
@@ -0,0 +1,31 @@
+import threading, time
+import anyio, uvicorn
+from mcp.server.mcpserver import MCPServer
+from kb.remote import search_remote
+
+seen = []
+server = MCPServer("kb")
+
+@server.tool()
+def search(query: str) -> str:
+    return f"Title A for {query}\n\n  Title B  \n"
+
+inner = server.streamable_http_app()
+
+async def app(scope, receive, send):
+    if scope["type"] == "http":
+        h = dict(scope["headers"]).get(b"authorization")
+        seen.append((scope["method"], h))
+        if h != b"Bearer s3cret":
+            await send({"type": "http.response.start", "status": 401, "headers": []})
+            await send({"type": "http.response.body", "body": b""})
+            return
+    await inner(scope, receive, send)
+
+srv = uvicorn.Server(uvicorn.Config(app, port=8765, log_level="warning"))
+threading.Thread(target=srv.run, daemon=True).start()
+while not srv.started:
+    time.sleep(0.05)
+print(anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "s3cret", "vpn"))
+print(seen)
+srv.should_exit = True
