+++ b/_smoke_http.py
@@ -0,0 +1,25 @@
+import subprocess
+import sys
+import time
+
+import anyio
+from mcp.client.session import ClientSession
+from mcp.client.streamable_http import streamable_http_client
+
+
+async def check():
+    async with streamable_http_client("http://127.0.0.1:8765/mcp") as streams:
+        async with ClientSession(streams[0], streams[1]) as s:
+            await s.initialize()
+            print([t.name for t in (await s.list_tools()).tools])
+            print((await s.call_tool("stock", {"sku": "MS-330"})).content)
+
+
+proc = subprocess.Popen([sys.executable, "-m", "app.server", "--http", "--port", "8765"])
+try:
+    time.sleep(3)
+    print("still running:", proc.poll() is None)
+    anyio.run(check)
+finally:
+    proc.terminate()
+    proc.wait()
