 def build_context(retriever: BaseRetriever, question: str) -> str:
-    raise NotImplementedError
+    """Numbered entries for the first MAX_SOURCES distinct sources the retriever returns."""
+    docs = retriever.invoke(question, config={"tags": [TRACE_TAG]})
+    seen: set[str] = set()
+    entries: list[str] = []
+    for doc in docs:
