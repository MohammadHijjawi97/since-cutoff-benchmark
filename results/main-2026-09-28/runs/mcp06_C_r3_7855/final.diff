+from mcp.server import MCPServer
+
+mcp = MCPServer("demo")
+
+
+@mcp.tool()
+def add(a: int, b: int) -> int:
+    return a + b
+
+
+@mcp.tool()
+def greet(name: str) -> str:
+    return f"Hello, {name}!"
+
+
+@mcp.tool()
+def boom() -> str:
+    raise ValueError("nope")
+
+
+if __name__ == "__main__":
+    mcp.run()
