+import sys
+
+import anyio
+
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path[:0] = [str(HERE), str(HERE.parent)]
+from srv import mcp  # noqa: E402
+
+from mcpcheck.cases import Case  # noqa: E402
+from mcpcheck.inproc import check_server  # noqa: E402
+from mcpcheck.stdio import check_command  # noqa: E402
+
+cases = [
+    Case("add", {"a": 2, "b": 3}, "5"),
+    Case("greet", {"name": "Ada"}, "Hi"),
+    Case("boom", {}, "x"),
+    Case("missing", {}, "y"),
+    Case("add", {"a": 1, "b": 1}, "3"),
+]
+
+
+async def main():
+    a = await check_server(mcp, cases)
+    b = await check_command([sys.executable, str(HERE / "srv.py")], cases)
+    for m in a:
+        print(m)
+    print("same as stdio:", a == b)
+
+
+anyio.run(main)
