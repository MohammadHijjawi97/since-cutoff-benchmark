 import logging
 
+import httpx2
 from huggingface_hub import HfApi
+from huggingface_hub.utils import _http as hf_http
 
 logger = logging.getLogger("app.network")
 
+TIMEOUT = httpx2.Timeout(60.0, connect=5.0)
+JOB_HEADERS = {"X-Acme-Job": "nightly-sync"}
+
+
+def _enforce_timeout(request: httpx2.Request) -> None:
+    # huggingface_hub passes `timeout=None` explicitly in many calls (e.g. `model_info`), which in httpx2
+    # disables every timeout instead of falling back to the client's. Restore ours in that case.
+    timeout = request.extensions.get("timeout")
+    if timeout is None or all(value is None for value in timeout.values()):
+        request.extensions = {**request.extensions, "timeout": TIMEOUT.as_dict()}
+
 
 def configure_hub_http(transport=None) -> None:
