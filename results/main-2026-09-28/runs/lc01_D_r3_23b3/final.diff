@@ -0,0 +1,37 @@
+from langchain_core.documents import Document
+
+from app.context import MAX_SOURCES, TRACE_TAG, build_context
+from app.kb import KeywordRetriever
+
+
+class TagRecordingRetriever(KeywordRetriever):
+    seen_tags: list[str] = []
+
+    def _get_relevant_documents(self, query, *, run_manager):
+        self.seen_tags.extend(run_manager.tags)
+        return super()._get_relevant_documents(query, run_manager=run_manager)
+
+
+def make_retriever(cls=KeywordRetriever):
+    docs = [
+        Document(page_content=f"  vpn note {i}  \n", metadata={"source": source})
+        for i, source in enumerate(["a.md", "a.md", "b.md", "c.md", "d.md"])
+    ]
+    return cls(docs=docs, k=5)
+
+
+def test_dedupes_limits_and_formats():
+    assert MAX_SOURCES == 3
+    assert build_context(make_retriever(), "vpn") == (
+        "[1] a.md\nvpn note 0\n\n[2] b.md\nvpn note 2\n\n[3] c.md\nvpn note 3"
+    )
+
+
+def test_empty_when_nothing_found():
+    assert build_context(make_retriever(), "kubernetes") == ""
+
+
+def test_lookup_carries_trace_tag():
+    retriever = make_retriever(TagRecordingRetriever)
+    build_context(retriever, "vpn")
+    assert TRACE_TAG in retriever.seen_tags
