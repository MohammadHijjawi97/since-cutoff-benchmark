+def _apply_timeout(request: httpx2.Request) -> None:
+    # HfApi passes `timeout=None` per request, which would disable the client's timeouts:
+    # fill every unset component with our default, keep values a caller set explicitly.
+    requested = request.extensions.get("timeout") or {}
+    defaults = HUB_TIMEOUT.as_dict()
+    request.extensions["timeout"] = {
+        key: requested.get(key) if requested.get(key) is not None else value for key, value in defaults.items()
+    }
+
 
