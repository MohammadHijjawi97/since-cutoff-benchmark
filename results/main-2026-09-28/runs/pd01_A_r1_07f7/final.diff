+import io
+
+import pandas as pd
+
+from app.clean import clean_orders
+from app.load import load_orders
+
+csv = "sku,qty,note,price\n  A1 ,2, hi ,1.5\nB2,,   ,2\n,3,x,\n"
+df = load_orders(io.StringIO(csv))
+print(dict(df.dtypes))
+before = df.copy()
+out = clean_orders(df)
+print(out)
+print(dict(out.dtypes))
+pd.testing.assert_frame_equal(df, before)
+
+o = pd.DataFrame(
+    {
+        "sku": pd.Series([" a ", "", None, 5], dtype=object),
+        "qty": [1, None, 2, None],
+        "note": ["x", " ", "y", "z"],
+    }
+)
+ob = o.copy()
+r = clean_orders(o)
+print(r)
+print(dict(r.dtypes))
+pd.testing.assert_frame_equal(o, ob)
