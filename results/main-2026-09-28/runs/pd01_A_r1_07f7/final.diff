 import pandas as pd
 
 
+def _clean_text(s: pd.Series) -> pd.Series:
+    """Strip whitespace from the strings in `s` and turn empty ones into missing."""
+    if isinstance(s.dtype, pd.StringDtype):
+        stripped = s.str.strip()
+    else:
+        # object columns may hold non-string values; leave those untouched
+        stripped = s.map(lambda v: v.strip() if isinstance(v, str) else v)
+    return stripped.mask(stripped.eq("") & stripped.notna())
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A cleaned copy of the orders frame; `df` itself is left unchanged."""
+    out = df.copy()
+    for col in out.select_dtypes(include=["object", "string"]).columns:
+        out[col] = _clean_text(out[col])
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+    return out
