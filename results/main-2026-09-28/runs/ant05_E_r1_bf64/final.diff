+import asyncio, json
+import httpx2
+from anthropic import AsyncAnthropic
+from app.worker import triage
+
+calls = []
+
+
+def handler(req):
+    calls.append(json.loads(req.content))
+    return httpx2.Response(
+        200,
+        headers={"anthropic-ratelimit-tokens-remaining": "1500", "request-id": "req_1"},
+        json={"id": "m", "type": "message", "role": "assistant", "model": "x",
+              "content": [{"type": "text", "text": "billing: charged twice"}],
+              "stop_reason": "end_turn", "stop_sequence": None,
+              "usage": {"input_tokens": 1, "output_tokens": 1}},
+    )
+
+
+async def main():
+    c = AsyncAnthropic(api_key="k", http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handler)))
+    print(await triage(c, "I was charged twice"))
+    print(len(calls), calls[0])
+
+
+asyncio.run(main())
