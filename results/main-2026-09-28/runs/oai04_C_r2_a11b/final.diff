@@ -0,0 +1,43 @@
+from types import SimpleNamespace
+
+from app.drafts import DRAFT_MODEL, MAX_DRAFT_TOKENS, STYLE_GUIDE, Draft, Ticket, draft_reply
+
+TICKET = Ticket(id="T-88", subject="Charged twice", body="My card was charged twice for September.")
+
+
+class FakeResponses:
+    def __init__(self, response):
+        self.response = response
+        self.calls = []
+
+    def create(self, **kwargs):
+        self.calls.append(kwargs)
+        return self.response
+
+
+def fake_response(text, status="completed", reason=None):
+    details = SimpleNamespace(reason=reason) if reason else None
+    return SimpleNamespace(output_text=text, status=status, incomplete_details=details)
+
+
+def test_draft_reply_sends_the_expected_request():
+    responses = FakeResponses(fake_response("  Hi there,\n\nSorry about that.\n"))
+    draft = draft_reply(SimpleNamespace(responses=responses), TICKET)
+    assert draft == Draft(ticket_id="T-88", text="Hi there,\n\nSorry about that.", truncated=False)
+    call = responses.calls[0]
+    assert call["model"] == DRAFT_MODEL
+    assert call["instructions"] == STYLE_GUIDE
+    assert call["input"] == "Charged twice\n\nMy card was charged twice for September."
+    assert call["max_output_tokens"] == MAX_DRAFT_TOKENS
+    assert call["store"] is False
+    assert call["metadata"] == {"ticket_id": "T-88"}
+
+
+def test_draft_hitting_the_token_cap_is_truncated():
+    responses = FakeResponses(fake_response("Hi there, we", "incomplete", "max_output_tokens"))
+    assert draft_reply(SimpleNamespace(responses=responses), TICKET).truncated is True
+
+
+def test_draft_incomplete_for_other_reasons_is_not_truncated():
+    responses = FakeResponses(fake_response("Hi", "incomplete", "content_filter"))
+    assert draft_reply(SimpleNamespace(responses=responses), TICKET).truncated is False
