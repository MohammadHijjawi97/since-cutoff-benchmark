+
+def sse(*deltas):
+    for d in deltas:
+        chunk = {
+            "id": "c", "object": "chat.completion.chunk", "created": 0, "model": chat.MODEL,
+            "choices": [{"index": 0, "delta": {"content": d}, "finish_reason": None}],
+        }
+        yield ("data: " + json.dumps(chunk) + "\n\n").encode()
+
+
+def dropping(*deltas, error):
+    yield from sse(*deltas)
+    raise error
+
+
+def completes(*deltas):
+    yield from sse(*deltas)
+    yield b"data: [DONE]\n\n"
+
+
+def client_for(*outcomes):
+    """A real OpenAI client whose successive requests get `outcomes` (an exception or a body)."""
+    outcomes = list(outcomes)
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        outcome = outcomes.pop(0)
+        if isinstance(outcome, Exception):
+            raise outcome
+        return httpx2.Response(200, headers={"content-type": "text/event-stream"}, content=outcome)
+
+    client = OpenAI(api_key="k", max_retries=0, http_client=httpx2.Client(transport=httpx2.MockTransport(handler)))
+    return client, requests
+
+
+def test_answer_returns_the_whole_text():
+    client, requests = client_for(completes("Reset ", "your password."))
+    assert chat.answer(client, "How do I log in?") == "Reset your password."
+    assert len(requests) == 1
+
+
+def test_answer_retries_a_dropped_stream_and_discards_its_fragments(caplog):
+    drop = httpx2.RemoteProtocolError("peer closed connection without sending complete message body")
+    client, requests = client_for(
+        httpx2.ConnectError("connection reset by peer"),
+        dropping("Half an ", error=drop),
+        completes("Full answer."),
+    )
+    history = iter([("Hi", "Hello!")])  # a one-shot iterable must survive the retries
+    with caplog.at_level(logging.WARNING, logger="app.chat"):
+        assert chat.answer(client, "Q?", history) == "Full answer."
+    assert len(requests) == 3
+    assert all(b"Hello!" in r.read() for r in requests)
+    warnings = [r.getMessage() for r in caplog.records if r.name == "app.chat" and r.levelno == logging.WARNING]
+    assert len(warnings) == 2
+    assert "connection reset by peer" in warnings[0]
+    assert "peer closed connection without sending complete message body" in warnings[1]
+
+
+def test_answer_gives_up_after_all_attempts(caplog):
+    client, requests = client_for(*[httpx2.ConnectError("unreachable")] * chat.ATTEMPTS)
+    with caplog.at_level(logging.WARNING, logger="app.chat"), pytest.raises(UpstreamUnavailable):
+        chat.answer(client, "Q?")
+    assert len(requests) == chat.ATTEMPTS
+    assert sum(r.name == "app.chat" for r in caplog.records) == chat.ATTEMPTS
+
+
+def test_answer_does_not_retry_a_read_timeout_mid_stream():
+    client, requests = client_for(dropping("Part", error=httpx2.ReadTimeout("read timed out")), completes("x"))
+    with pytest.raises(UpstreamTimeout):
+        chat.answer(client, "Q?")
+    assert len(requests) == 1
+
+
+def test_answer_does_not_retry_a_connect_timeout():
+    client, requests = client_for(httpx2.ConnectTimeout("connect timed out"), completes("x"))
+    with pytest.raises(UpstreamTimeout):
+        chat.answer(client, "Q?")
+    assert len(requests) == 1
