+    """The complete answer to `question` (used by the e-mail channel).
+
+    A connection that fails or drops mid-stream is retried from the start, up to ATTEMPTS
+    times in total; a timeout is not retried.
+    """
+    history = list(history)  # may be a one-shot iterable, and each attempt needs it
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            return "".join(iter_answer(client, question, history))
+        except APITimeoutError as err:  # subclass of APIConnectionError, so check it first
+            raise UpstreamTimeout(_network_error_message(err)) from err
+        except APIConnectionError as err:
+            logger.warning(
+                "Answer attempt %d/%d failed: %s", attempt, ATTEMPTS, _network_error_message(err)
+            )
+            last_error = err
+    raise UpstreamUnavailable(_network_error_message(last_error)) from last_error
+
+
+def _network_error_message(err: BaseException) -> str:
+    """The message of the network error behind `err`.
+
+    The SDK wraps network errors in its own ("Connection error."), so use the innermost cause.
+    """
+    while err.__cause__ is not None:
+        err = err.__cause__
+    return str(err) or type(err).__name__
