@@ -0,0 +1,21 @@
+import httpx2
+import openai
+import pytest
+
+from app import digest
+from tests.fakes import mock_openai
+
+
+def test_before_and_after():
+    early = openai.OpenAI(api_key="x", max_retries=0)
+    digest.get_client()
+    with mock_openai("a", "b") as seen:
+        assert early.chat.completions.create(model="m", messages=[]).choices[0].message.content == "a"
+        assert digest.summarize("t") == "b"
+        late = openai.OpenAI(api_key="x", max_retries=0)
+        with pytest.raises(openai.BadRequestError):
+            late.chat.completions.create(model="m", messages=[])
+    assert len(seen) == 3
+    assert httpx2.Client._transport_for_url.__qualname__ == "Client._transport_for_url"
+    with pytest.raises(openai.APIConnectionError):
+        early.chat.completions.create(model="m", messages=[])
