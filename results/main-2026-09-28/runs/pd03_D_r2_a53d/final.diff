@@ -6,4 +6,15 @@
 
 
 def fill_gaps(readings: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Fill missing temperatures from the same station only.
+
+    A gap takes the station's most recent earlier temperature or, failing that, its
+    first later one. Rows without a station are never filled.
+    """
+    filled = readings.copy()
+    # Work on a positional index so duplicate or unordered labels cannot misalign values.
+    temp = readings["temp_c"].reset_index(drop=True)
+    by_station = temp.groupby(readings["station"].reset_index(drop=True), sort=False)
+    temp = temp.fillna(by_station.ffill()).fillna(by_station.bfill())
+    filled["temp_c"] = temp.to_numpy()
+    return filled
