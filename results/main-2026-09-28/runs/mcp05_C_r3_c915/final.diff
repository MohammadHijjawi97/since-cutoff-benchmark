--- /dev/null
+++ b/.tmpcheck/check.py
@@ -0,0 +1,39 @@
+import sys, os, threading, time
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+import uvicorn
+from mcp.server import MCPServer
+from kb.remote import search_remote
+import anyio
+
+seen = []
+server = MCPServer("kb")
+
+@server.tool()
+def search(query: str) -> str:
+    return f"Title A for {query}\n\nTitle B\n"
+
+app = server.streamable_http_app()
+
+class Auth:
+    def __init__(self, app): self.app = app
+    async def __call__(self, scope, receive, send):
+        if scope["type"] == "http":
+            h = dict(scope["headers"]).get(b"authorization")
+            seen.append((scope["method"], h))
+            if h != b"Bearer s3cret":
+                await send({"type": "http.response.start", "status": 401, "headers": []})
+                await send({"type": "http.response.body", "body": b""})
+                return
+        await self.app(scope, receive, send)
+
+cfg = uvicorn.Config(Auth(app), host="127.0.0.1", port=8765, log_level="warning")
+srv = uvicorn.Server(cfg)
+t = threading.Thread(target=srv.run, daemon=True); t.start()
+while not srv.started: time.sleep(0.05)
+print(anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "s3cret", "hello"))
+print(seen)
+try:
+    anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "wrong", "hello")
+except BaseException as e:
+    print("bad token ->", type(e).__name__, e)
+srv.should_exit = True; t.join()
