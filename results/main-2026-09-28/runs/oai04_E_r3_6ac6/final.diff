 def draft_reply(client: OpenAI, ticket: Ticket) -> Draft:
-    raise NotImplementedError
+    """A reply draft for the ticket, flagged as truncated when it hit MAX_DRAFT_TOKENS."""
+    response = client.responses.create(
+        model=DRAFT_MODEL,
+        instructions=STYLE_GUIDE,
+        input=f"{ticket.subject}\n\n{ticket.body}",
+        max_output_tokens=MAX_DRAFT_TOKENS,
+        store=False,
+        metadata={"ticket_id": ticket.id},
+    )
+    # incomplete_details is None for a finished response; other reasons (e.g. content_filter)
+    # are not a token-cap cut-off.
+    details = getattr(response, "incomplete_details", None)
+    truncated = getattr(details, "reason", None) == "max_output_tokens"
+    return Draft(ticket_id=ticket.id, text=response.output_text.strip(), truncated=truncated)
