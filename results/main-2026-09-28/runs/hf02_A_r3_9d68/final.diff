-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+RUN_IGNORE_PATTERNS = ["*.tmp", "wandb/*"]
+
+
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> str:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`; return the last commit URL.
+
+    With hf_xet installed (a huggingface_hub dependency), `upload_folder` splits very large folders into
+    several commits and resumes an interrupted upload when called again: files already committed are
+    skipped and data already uploaded is deduplicated.
+    """
+    api = api or HfApi()
+    run_dir = Path(run_dir)
+    api.create_repo(repo_id=repo_id, repo_type="dataset", private=True, exist_ok=True)
+    info = api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=run_dir,
+        ignore_patterns=list(RUN_IGNORE_PATTERNS),
+        commit_message=f"Upload run {run_dir.name}",
+    )
+    return info.commit_url
