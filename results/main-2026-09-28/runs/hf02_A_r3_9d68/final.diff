+
+
+class RecordingFolderApi:
+    def __init__(self):
+        self.calls = []
+
+    def create_repo(self, **kwargs):
+        self.calls.append(("create_repo", kwargs))
+
+    def upload_folder(self, **kwargs):
+        self.calls.append(("upload_folder", kwargs))
+        return SimpleNamespace(commit_url="https://huggingface.co/datasets/acme-ml/run-0007/commit/def")
+
+
+def test_publish_run_mirrors_the_folder_into_a_private_dataset_repo(tmp_path):
+    api = RecordingFolderApi()
+
+    url = publish_run(tmp_path, "acme-ml/run-0007", api=api)
+
+    assert url.endswith("/commit/def")
+    (_, create), (_, upload) = api.calls
+    assert create == {"repo_id": "acme-ml/run-0007", "repo_type": "dataset", "private": True, "exist_ok": True}
+    assert upload["repo_id"] == "acme-ml/run-0007" and upload["repo_type"] == "dataset"
+    assert upload["folder_path"] == tmp_path and upload.get("path_in_repo") is None
+    files = ["ckpt/model.safetensors", "ckpt/model.safetensors.tmp", "wandb/run/log.txt", "metrics.json"]
+    kept = list(filter_repo_objects(files, ignore_patterns=upload["ignore_patterns"]))
+    assert kept == ["ckpt/model.safetensors", "metrics.json"]
