 import pandas as pd
 
 
+def _clean_text(s: pd.Series) -> pd.Series:
+    if pd.api.types.is_string_dtype(s.dtype) and s.dtype != object:
+        s = s.str.strip()
+    else:
+        # object columns may hold non-string values; only touch the strings
+        s = s.map(lambda v: v.strip() if isinstance(v, str) else v)
+    return s.mask(s.map(lambda v: isinstance(v, str) and v == ""))
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A copy of ``df`` with text trimmed, blank text missing and missing qty 0."""
+    out = df.copy()
+    for col in out.select_dtypes(include=["object", "string"]).columns:
+        out[col] = _clean_text(out[col])
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+    return out
