--- /dev/null
+++ b/_smoke.py
@@ -0,0 +1,28 @@
+import json
+
+import httpx2
+from anthropic import Anthropic, DefaultHttpxClient
+
+from app.audit import ask_with_audit
+
+body = json.dumps({
+    "id": "msg_1", "type": "message", "role": "assistant", "model": "claude-opus-5-5",
+    "content": [{"type": "text", "text": "Hello "}, {"type": "text", "text": "world"}],
+    "stop_reason": "end_turn", "stop_sequence": None,
+    "usage": {"input_tokens": 1, "output_tokens": 2},
+})
+
+
+def handler(req):
+    sent = json.loads(req.content)
+    assert sent["max_tokens"] == 256 and sent["model"] == "claude-opus-5-5", sent
+    assert sent["messages"] == [{"role": "user", "content": "hi"}], sent
+    return httpx2.Response(
+        200, headers={"request-id": "req_abc", "content-type": "application/json"}, text=body
+    )
+
+
+c = Anthropic(api_key="x", http_client=DefaultHttpxClient(transport=httpx2.MockTransport(handler)))
+r = ask_with_audit(c, "hi")
+assert r == {"request_id": "req_abc", "raw_body": body, "answer": "Hello world"}, r
+print("smoke OK")
