@@ -0,0 +1,35 @@
+import anyio
+from mcp.server.mcpserver import MCPServer
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+
+
+def make_server() -> MCPServer:
+    server = MCPServer("demo")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"Hello, {name}!"
+
+    return server
+
+
+def test_check_server_reports_mismatches_in_order():
+    cases = [
+        Case("add", {"a": 2, "b": 3}, "5"),
+        Case("greet", {"name": "Ada"}, "Hi, Ada"),
+        Case("add", {"a": 1, "b": 1}, "3"),
+        Case("greet", {"name": "Bob"}, "Hello, Bob!"),
+    ]
+    mismatches = anyio.run(check_server, make_server(), cases)
+    assert mismatches == [Mismatch(cases[1], "Hello, Ada!"), Mismatch(cases[2], "2")]
+
+
+def test_check_server_all_passing():
+    cases = [Case("add", {"a": 2, "b": 3}, "5"), Case("greet", {"name": "Ada"}, "Hello, Ada!")]
+    assert anyio.run(check_server, make_server(), cases) == []
