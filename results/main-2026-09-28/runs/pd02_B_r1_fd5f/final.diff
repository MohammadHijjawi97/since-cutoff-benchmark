 import pandas as pd
 
 
+def _format_amount(value: object) -> str:
+    """Accounting-style cell: "12,500.00", "(634.20)", "-" for zero, "" for missing."""
+    if pd.isna(value):
+        return ""
+    amount = round(float(value), 2)
+    if amount == 0:
+        return "-"
+    if amount < 0:
+        return f"({-amount:,.2f})"
+    return f"{amount:,.2f}"
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Copy of the account x month table with every cell as an accounting-style string."""
+    return table.map(_format_amount)
