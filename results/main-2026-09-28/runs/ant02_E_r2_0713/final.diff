--- /dev/null
+++ b/_check_audit.py
@@ -0,0 +1,36 @@
+import json
+
+from anthropic import Anthropic, _response
+
+from app.audit import ask_with_audit
+
+httpx = _response.httpx2
+body = json.dumps(
+    {
+        "id": "msg_1",
+        "type": "message",
+        "role": "assistant",
+        "model": "claude-opus-5-5",
+        "content": [{"type": "text", "text": "Hel"}, {"type": "text", "text": "lo"}],
+        "stop_reason": "end_turn",
+        "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 2},
+    },
+    separators=(",", ":"),
+)
+seen = {}
+
+
+def handler(req):
+    seen["body"] = json.loads(req.content)
+    return httpx.Response(
+        200, headers={"request-id": "req_abc", "content-type": "application/json"}, text=body
+    )
+
+
+client = Anthropic(api_key="x", http_client=httpx.Client(transport=httpx.MockTransport(handler)))
+out = ask_with_audit(client, "hi")
+print(out)
+print(seen["body"])
+assert out == {"request_id": "req_abc", "raw_body": body, "answer": "Hello"}
+print("OK")
