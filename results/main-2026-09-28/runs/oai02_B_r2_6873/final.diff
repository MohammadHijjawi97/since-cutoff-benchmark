+import time
+
+t0 = time.perf_counter()
+import openai
+from app import digest
+from tests.fakes import mock_openai
+
+print("imports", round(time.perf_counter() - t0, 2))
+
+before = openai.OpenAI(api_key="k", max_retries=0, timeout=3)
+digest.get_client()  # cache it before the block too
+msgs = [{"role": "user", "content": "hi"}]
+t0 = time.perf_counter()
+with mock_openai("a", "b", "c") as seen:
+    print(before.chat.completions.create(model="m", messages=msgs).choices[0].message.content)
+    inside = openai.OpenAI(api_key="k", max_retries=0)
+    print(inside.chat.completions.create(model="m", messages=msgs).choices[0].message.content)
+    print(digest.summarize("t"))
+    try:
+        before.chat.completions.create(model="m", messages=msgs)
+    except openai.BadRequestError as e:
+        print("exhausted ->", e.status_code)
+print("seen", len(seen), "block time", round(time.perf_counter() - t0, 2))
+try:
+    before.chat.completions.create(model="m", messages=msgs)
+    print("AFTER: still intercepted!")
+except openai.APIConnectionError as e:
+    print("after block -> real network attempted:", type(e).__name__)
