+class HTTPX2TransportMocker(AbstractRequestMocker):
+    """Lets respx routers answer requests sent through `httpx2`, which the openai SDK uses since 3.x.
+
+    respx only patches `httpx` and `httpcore`, so without this the SDK's requests bypass the router
+    and go to the network. Patching the transport class (not a client) also covers clients created
+    before the router started, and respx removes the patch when the router stops.
+    """
+
+    name = HTTPX2_MOCKER
+    targets = ["httpx2._transports.default.HTTPTransport"]
+    target_methods = ["handle_request"]
+
+    @classmethod
+    def to_httpx_request(cls, **kwargs):
+        request: httpx2.Request = kwargs["request"]
+        # Reading replaces a one-shot body stream with a replayable one, for pass-through.
+        content = request.read()
+        return httpx.Request(request.method, str(request.url), headers=request.headers.raw, content=content)
+
+    @classmethod
+    def prepare_sync_request(cls, httpx_request, **kwargs):
+        return httpx_request, kwargs
+
+    @classmethod
+    def from_sync_httpx_response(cls, httpx_response, target, **kwargs):
+        return httpx2.Response(
+            httpx_response.status_code,
+            headers=httpx_response.headers.raw,
+            content=httpx_response.read(),
+        )
 
 
