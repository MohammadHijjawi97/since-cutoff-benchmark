+import numpy as np
+import pandas as pd
+
+from app.ledger import load_ledger, monthly_pnl
+from app.report import format_for_display
+
+from tests.test_ledger import DATA
+
+
+def test_format_for_display_accounting_style():
+    table = pd.DataFrame(
+        {"2026-07": [12500.0, -634.2, 0.0, np.nan], "2026-08": [1234567.891, -0.0, 1e-12, -5.0]},
+        index=["A", "B", "C", "D"],
+    )
+    original = table.copy()
+
+    shown = format_for_display(table)
+
+    assert shown.loc["A", "2026-07"] == "12,500.00"
+    assert shown.loc["B", "2026-07"] == "(634.20)"
+    assert shown.loc["C", "2026-07"] == "-"
+    assert shown.loc["D", "2026-07"] == ""
+    assert shown.loc["A", "2026-08"] == "1,234,567.89"
+    assert shown.loc["B", "2026-08"] == "-"
+    assert shown.loc["C", "2026-08"] == "-"
+    assert shown.loc["D", "2026-08"] == "(5.00)"
+    pd.testing.assert_frame_equal(table, original)
+
+
+def test_format_for_display_keeps_shape_of_monthly_pnl():
+    table = monthly_pnl(load_ledger(DATA))
+    shown = format_for_display(table)
+    assert shown.index.equals(table.index)
+    assert shown.columns.equals(table.columns)
+    assert all(isinstance(v, str) for v in shown.to_numpy().ravel())
+    assert shown.loc["Revenue", "2026-07"] == "12,500.00"
+    assert shown.loc["Salaries", "2026-08"] == "(8,200.00)"
+    assert shown.loc["Travel", "2026-07"] == ""
