 import pandas as pd
 
 
+def _format_amount(value: object) -> str:
+    """Accounting style: 1,234.50 / (634.20) for negatives / - for zero / "" for missing."""
+    if pd.isna(value):
+        return ""
+    amount = round(float(value), 2)
+    # Anything that shows as 0.00 (including -0.0 and float noise from summing) is a zero.
+    if amount == 0:
+        return "-"
+    text = f"{abs(amount):,.2f}"
+    return f"({text})" if amount < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
