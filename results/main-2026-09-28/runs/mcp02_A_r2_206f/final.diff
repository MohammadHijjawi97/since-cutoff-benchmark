+import anyio
+from mcp.client.client import Client
+from mcp.server.mcpserver.server import MCPServer
+from opsbot.calls import run_tool, ToolCallFailed
+
+srv = MCPServer("t")
+
+
+@srv.tool()
+def status(svc: str) -> dict:
+    return {"svc": svc, "up": True}
+
+
+@srv.tool()
+def count() -> int:
+    return 0
+
+
+@srv.tool(structured_output=False)
+def hello(who: str) -> str:
+    return f"hi {who}"
+
+
+@srv.tool()
+def boom() -> str:
+    raise ValueError("no such version")
+
+
+async def main():
+    async with Client(srv) as c:
+        s = c.session
+        print(repr(await run_tool(s, "status", {"svc": "api"})))
+        print(repr(await run_tool(s, "count", {})))
+        print(repr(await run_tool(s, "hello", {"who": "bob"})))
+        try:
+            await run_tool(s, "boom", {})
+        except ToolCallFailed as e:
+            print("failed:", e.tool, repr(e.message))
+
+
+anyio.run(main)
