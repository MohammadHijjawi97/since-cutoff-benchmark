@@ -0,0 +1,70 @@
+from typing_extensions import TypedDict
+
+import anyio
+import pytest
+from mcp.client.client import Client
+from mcp.server.mcpserver.exceptions import ToolError
+from mcp.server.mcpserver.server import MCPServer
+from mcp.types import CallToolResult, TextContent
+
+from opsbot.calls import ToolCallFailed, run_tool
+
+server = MCPServer("ops-test")
+
+
+class Status(TypedDict):
+    service: str
+    up: bool
+
+
+@server.tool()
+def status(service: str) -> Status:
+    return {"service": service, "up": True}
+
+
+@server.tool()
+def pending() -> CallToolResult:
+    return CallToolResult(content=[TextContent(text="nothing pending")], structured_content=0)
+
+
+@server.tool()
+def greet(who: str) -> CallToolResult:
+    return CallToolResult(content=[TextContent(text="hi"), TextContent(text=who)])
+
+
+@server.tool()
+def deploy(version: str) -> str:
+    raise ToolError("no such version")
+
+
+def call(name, arguments):
+    # Catch inside the client context: exceptions leaving it get wrapped in an ExceptionGroup.
+    async def go():
+        async with Client(server) as client:
+            try:
+                return await run_tool(client.session, name, arguments), None
+            except ToolCallFailed as exc:
+                return None, exc
+
+    value, exc = anyio.run(go)
+    if exc is not None:
+        raise exc
+    return value
+
+
+def test_returns_structured_output():
+    assert call("status", {"service": "api"}) == {"service": "api", "up": True}
+
+
+def test_returns_falsy_structured_output():
+    assert call("pending", {}) == 0
+
+
+def test_joins_text_blocks_without_structured_output():
+    assert call("greet", {"who": "ops"}) == "hi\nops"
+
+
+def test_raises_when_tool_fails():
+    with pytest.raises(ToolCallFailed) as info:
+        call("deploy", {"version": "9.9.9"})
+    assert (info.value.tool, info.value.message) == ("deploy", "Error executing tool deploy: no such version")
