+import asyncio, json
+
+import httpx2 as httpx
+from anthropic import AsyncAnthropic
+
+from app.worker import triage
+
+calls = []
+
+
+def handler(req):
+    calls.append(json.loads(req.content))
+    return httpx.Response(
+        200,
+        headers={"anthropic-ratelimit-tokens-remaining": "1500", "request-id": "req_1"},
+        json={
+            "id": "msg_1", "type": "message", "role": "assistant", "model": "m",
+            "stop_reason": "end_turn", "stop_sequence": None,
+            "content": [{"type": "text", "text": "billing: refund"}],
+            "usage": {"input_tokens": 1, "output_tokens": 1},
+        },
+    )
+
+
+c = AsyncAnthropic(api_key="x", http_client=httpx.AsyncClient(transport=httpx.MockTransport(handler)))
+print(asyncio.run(triage(c, "charged twice")))
+print(len(calls), calls[0]["max_tokens"], calls[0]["model"], calls[0]["messages"])
