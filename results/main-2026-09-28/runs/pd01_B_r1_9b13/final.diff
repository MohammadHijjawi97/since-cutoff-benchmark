 """Cleaning step of the orders ETL."""
 
+import numpy as np
 import pandas as pd
 
 
+def _clean_text_value(value):
+    if isinstance(value, str):
+        value = value.strip()
+        return value if value else np.nan
+    return value
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A copy of the orders frame with tidied text columns and missing qty set to 0."""
+    out = df.copy()
+
+    for col in out.columns:
+        s = out[col]
+        if isinstance(s.dtype, pd.StringDtype):
+            s = s.str.strip()
+            out[col] = s.mask(s == "")
+        elif s.dtype == object:
+            # Mixed/object columns: only touch the string values.
+            out[col] = s.map(_clean_text_value)
+
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+
+    return out
