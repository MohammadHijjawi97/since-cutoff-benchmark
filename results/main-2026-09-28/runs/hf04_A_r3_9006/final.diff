+import logging
+
+import httpx2
+from huggingface_hub import HfApi
+from huggingface_hub.errors import RepositoryNotFoundError
+
+from app.network import configure_hub_http, current_revision
+
+logging.basicConfig()
+seen = []
+
+
+def handler(req):
+    seen.append(req)
+    if "missing" in str(req.url):
+        return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, json={"error": "nope"})
+    if "down" in str(req.url):
+        raise httpx2.ConnectTimeout("boom", request=req)
+    return httpx2.Response(200, json={"id": "a/b", "sha": "deadbeef", "modelId": "a/b", "private": False})
+
+
+configure_hub_http(httpx2.MockTransport(handler))
+print(current_revision("a/b"))
+r = seen[-1]
+print(r.url, r.headers["X-Acme-Job"], r.headers["user-agent"][:30], r.extensions["timeout"])
+print(current_revision("a/down"))
+try:
+    current_revision("a/missing")
+except RepositoryNotFoundError as e:
+    print("raised", type(e).__name__)
+HfApi().model_info("a/b", timeout=3)
+print(seen[-1].extensions["timeout"])
