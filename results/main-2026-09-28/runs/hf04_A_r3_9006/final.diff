+def _apply_default_timeout(request: httpx2.Request) -> None:
+    # HfApi methods pass `timeout=None` explicitly, which httpx2 treats as "no timeout" and which would override
+    # the client default. Only fill in our timeout when the caller did not set any.
+    timeout = request.extensions.get("timeout")
+    if timeout is None or all(value is None for value in timeout.values()):
+        request.extensions["timeout"] = HUB_TIMEOUT.as_dict()
