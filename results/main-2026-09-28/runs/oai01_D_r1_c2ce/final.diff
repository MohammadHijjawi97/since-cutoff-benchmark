+import logging
+
+import httpx2
+
+logging.basicConfig(level=logging.INFO, format="%(name)s %(levelname)s %(message)s")
+logging.getLogger("openai").setLevel(logging.WARNING)
+from app.llm_client import build_client
+
+calls = []
+
+
+def handler(req):
+    calls.append(req)
+    if len(calls) == 1:
+        return httpx2.Response(500, json={"error": {"message": "boom"}})
+    return httpx2.Response(200, json={"object": "list", "data": []})
+
+
+c = build_client("sk-test", transport=httpx2.MockTransport(handler))
+c.models.list()
+print("calls", len(calls), "retries", c.max_retries, "timeout", c.timeout)
+print("request timeout ext", calls[-1].extensions.get("timeout"))
