+def _apply_job_settings(request: httpx2.Request) -> None:
+    # Many HfApi methods pass `timeout=None` per request, which would disable the
+    # client's timeout; enforce ours on every request instead.
+    request.extensions = {**request.extensions, "timeout": HUB_TIMEOUT.as_dict()}
+    request.headers.update(JOB_HEADERS)
+
 
