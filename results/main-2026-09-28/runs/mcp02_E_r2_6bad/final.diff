--- /dev/null
+++ b/_smoke.py
@@ -0,0 +1,36 @@
+import anyio
+from mcp import Client
+from mcp.server.mcpserver import MCPServer
+from opsbot.calls import run_tool, ToolCallFailed
+
+srv = MCPServer("t")
+
+
+@srv.tool()
+def status(service: str) -> dict[str, object]:
+    return {"service": service, "up": True}
+
+
+@srv.tool(structured_output=False)
+def echo(text: str) -> str:
+    return text
+
+
+@srv.tool()
+def deploy(version: str) -> str:
+    raise ValueError("no such version")
+
+
+async def main():
+    async with Client(srv) as c:
+        s = c.session
+        print("RAW:", await s.call_tool("status", {"service": "api"}))
+        print(repr(await run_tool(s, "status", {"service": "api"})))
+        print(repr(await run_tool(s, "echo", {"text": "hello"})))
+        try:
+            await run_tool(s, "deploy", {"version": "9"})
+        except ToolCallFailed as e:
+            print("FAILED:", e.tool, repr(e.message))
+
+
+anyio.run(main)
