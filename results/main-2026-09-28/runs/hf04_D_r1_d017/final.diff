@@ -0,0 +1,36 @@
+import logging
+
+import httpx2
+import pytest
+from huggingface_hub import HfApi, get_session
+from huggingface_hub.errors import RepositoryNotFoundError
+
+from app.network import configure_hub_http, current_revision
+
+seen = []
+
+
+def handler(req):
+    seen.append(req)
+    if "missing" in str(req.url):
+        return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, json={"error": "nope"}, request=req)
+    if "down" in str(req.url):
+        raise httpx2.ConnectError("refused", request=req)
+    if "slow" in str(req.url):
+        raise httpx2.ReadTimeout("slow", request=req)
+    return httpx2.Response(200, json={"id": "a/b", "sha": "deadbeef", "siblings": []}, request=req)
+
+
+configure_hub_http(transport=httpx2.MockTransport(handler))
+assert current_revision("a/b") == "deadbeef"
+HfApi().model_info("a/b")
+r = seen[-1]
+assert r.headers["X-Acme-Job"] == "nightly-sync" and "hf_hub/" in r.headers["user-agent"]
+assert r.extensions["timeout"] == {"connect": 5.0, "read": 60.0, "write": 60.0, "pool": 60.0}
+assert get_session() is get_session()
+logging.basicConfig()
+assert current_revision("a/down") is None
+assert current_revision("a/slow") is None
+with pytest.raises(RepositoryNotFoundError):
+    current_revision("a/missing")
+print("OK")
