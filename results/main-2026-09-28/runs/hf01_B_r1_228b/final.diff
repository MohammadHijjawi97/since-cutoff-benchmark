+import json
+from unittest import mock
+
+from huggingface_hub import InferenceClient
+
+from app.tgi import complete_paragraph
+
+
+def test_complete_paragraph_sends_tgi_params_and_strips_output():
+    captured = {}
+
+    def fake_post(self, request_parameters, stream=False):
+        captured["url"] = request_parameters.url
+        captured["json"] = request_parameters.json
+        return json.dumps([{"generated_text": " world, again.  \n\n"}]).encode()
+
+    with mock.patch.object(InferenceClient, "_inner_post", fake_post):
+        result = complete_paragraph("http://tgi.internal:8080", "Hello")
+
+    assert result == " world, again."
+    assert captured["url"].startswith("http://tgi.internal:8080")
+    assert captured["json"]["inputs"] == "Hello"
+    params = captured["json"]["parameters"]
+    assert params["max_new_tokens"] == 200
+    assert params["stop"] == ["\n\n"]
+    assert params["return_full_text"] is False
