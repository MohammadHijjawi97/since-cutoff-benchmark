@@ -0,0 +1,40 @@
+import pytest
+from mcp.server import MCPServer
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+
+pytestmark = pytest.mark.anyio
+
+
+@pytest.fixture
+def anyio_backend():
+    return "asyncio"
+
+
+def make_server() -> MCPServer:
+    server = MCPServer("demo")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"Hi {name}"
+
+    return server
+
+
+async def test_check_server():
+    good = Case("add", {"a": 2, "b": 3}, "5")
+    bad = Case("greet", {"name": "Ada"}, "Hello, Ada!")
+    also_bad = Case("add", {"a": 1, "b": 1}, "3")
+    assert await check_server(make_server(), [good, bad, also_bad]) == [
+        Mismatch(bad, "Hi Ada"),
+        Mismatch(also_bad, "2"),
+    ]
+
+
+async def test_check_server_no_mismatches():
+    assert await check_server(make_server(), [Case("add", {"a": 2, "b": 3}, "5")]) == []
