-async def check_server(server: Any, cases: list[Case]) -> list[Mismatch]:
-    raise NotImplementedError
+async def check_server(server: MCPServer, cases: list[Case]) -> list[Mismatch]:
+    """Connect to `server` in memory, call every case's tool in order and return the mismatches."""
+    mismatches: list[Mismatch] = []
+    # "legacy" runs the server over in-memory JSON-RPC streams with the initialize handshake,
+    # the same protocol path `check_command` takes over stdio.
+    async with Client(server, mode="legacy") as client:
+        session = client.session
+        for case in cases:
+            result = await session.call_tool(case.tool, case.arguments)
+            mismatch = compare(case, result)
+            if mismatch is not None:
+                mismatches.append(mismatch)
+    return mismatches
