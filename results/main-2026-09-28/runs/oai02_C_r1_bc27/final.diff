@@ -0,0 +1,26 @@
+import httpx
+import openai
+import pytest
+from openai import OpenAI
+
+from tests.fakes import mock_openai
+
+
+def ask(client):
+    return client.chat.completions.create(model="m", messages=[{"role": "user", "content": "hi"}])
+
+
+def test_all_the_claims():
+    before = OpenAI(api_key="x", max_retries=0)
+    legacy = OpenAI(api_key="x", max_retries=0, http_client=httpx.Client())
+    with mock_openai("a", "b", "c") as seen:
+        inside = OpenAI(api_key="x", max_retries=0)
+        assert ask(before).choices[0].message.content == "a"
+        assert ask(inside).choices[0].message.content == "b"
+        assert ask(legacy).choices[0].message.content == "c"
+        with pytest.raises(openai.BadRequestError):
+            ask(before)
+    assert len(seen) == 4
+    with pytest.raises(Exception) as info:
+        ask(before)
+    assert "Socket" in type(info.value.__cause__ or info.value).__name__ or isinstance(info.value, openai.APIConnectionError)
