+class _HubClient(httpx2.Client):
+    """Client whose timeouts cannot be switched off per request.
+
+    huggingface_hub passes ``timeout=None`` explicitly (e.g. ``HfApi.model_info``), which httpx2 treats as
+    "no timeout at all" instead of "use the client default". Map it back to the client default.
+    """
+
+    def build_request(self, *args, **kwargs) -> httpx2.Request:
+        if kwargs.get("timeout", httpx2.USE_CLIENT_DEFAULT) is None:
+            kwargs["timeout"] = httpx2.USE_CLIENT_DEFAULT
+        return super().build_request(*args, **kwargs)
+
 
 def configure_hub_http(transport=None) -> None:
-    raise NotImplementedError
