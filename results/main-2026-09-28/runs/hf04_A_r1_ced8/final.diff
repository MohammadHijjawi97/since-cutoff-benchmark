+        # Keep huggingface_hub's own defaults (request hook, redirects); request headers such as its
+        # user agent are merged with the client headers by httpx2.
+        return _HubClient(
+            event_hooks={"request": [hf_request_event_hook]},
+            follow_redirects=True,
+            timeout=HUB_TIMEOUT,
+            headers=JOB_HEADERS,
+            transport=transport,
+        )
+
+    # Closes any existing shared client; the next request creates one from this factory.
+    set_client_factory(client_factory)
 
 
