 """Cleaning step of the orders ETL."""
 
+import numpy as np
 import pandas as pd
 
 
+def _clean_text(value):
+    """Strip a string, turning an empty result into a missing value."""
+    if isinstance(value, str):
+        return value.strip() or np.nan
+    return value
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A copy of the orders frame with tidied text and missing qty set to 0."""
+    out = df.copy()
+    for col in out.select_dtypes(include=["object", "string"]).columns:
+        s = out[col]
+        if isinstance(s.dtype, pd.StringDtype):
+            s = s.str.strip()
+            out[col] = s.mask(s == "")
+        else:
+            # object columns may hold non-strings; leave those untouched
+            out[col] = s.map(_clean_text)
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+    return out
--- a/tests/test_clean_module.py
