 import pandas as pd
 
 
+def _format_amount(value: object) -> str:
+    """Accounting-style text for one amount: "12,500.00", "(634.20)", "-" for zero, "" for missing."""
+    if pd.isna(value):
+        return ""
+    text = f"{abs(float(value)):,.2f}"
+    # Compare after rounding so float residue from summing (e.g. -1e-13) shows as zero, not "(0.00)".
+    if text == "0.00":
+        return "-"
+    return f"({text})" if value < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Return a copy of the account x month table with every cell formatted as accounting-style text."""
+    return table.map(_format_amount)
