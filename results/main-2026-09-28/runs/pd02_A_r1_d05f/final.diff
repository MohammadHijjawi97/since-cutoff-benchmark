 import pandas as pd
 
 
+def _format_amount(value: float) -> str:
+    """Accounting style: 1,234.50, negatives in parentheses, zero as "-", missing as ""."""
+    if pd.isna(value):
+        return ""
+    # Round to cents first so float residue from summing (e.g. -1e-13) shows as "-", not "(0.00)".
+    cents = round(float(value), 2)
+    if cents == 0:
+        return "-"
+    if cents < 0:
+        return f"({-cents:,.2f})"
+    return f"{cents:,.2f}"
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Return a copy of the account x month table with every cell formatted for display."""
+    return table.map(_format_amount)
