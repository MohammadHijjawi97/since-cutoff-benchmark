 import pandas as pd
 
 
+def _format_amount(value: object) -> str:
+    """Accounting-style text for one amount: 1,234.50 / (634.20) / - / ""."""
+    if pd.isna(value):
+        return ""
+    # Round first so float noise from summing (e.g. -1e-13) shows as zero, not "(0.00)".
+    amount = round(float(value), 2)
+    if amount == 0:
+        return "-"
+    if amount < 0:
+        return f"({-amount:,.2f})"
+    return f"{amount:,.2f}"
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Return a copy of the account x month table with every cell as accounting-style text."""
+    return table.map(_format_amount).astype(object)
