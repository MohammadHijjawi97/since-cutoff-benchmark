--- /dev/null
+++ b/_check_remote.py
@@ -0,0 +1,46 @@
+import socket
+import threading
+import time
+
+import anyio
+import uvicorn
+from starlette.responses import PlainTextResponse
+
+from mcp.server.mcpserver import MCPServer
+from kb.remote import search_remote
+
+server = MCPServer("kb")
+
+
+@server.tool()
+def search(query: str) -> str:
+    return f"Rotating API keys\n\n  {query} \n"
+
+
+seen = []
+inner = server.streamable_http_app()
+
+
+async def app(scope, receive, send):
+    if scope["type"] == "http":
+        auth = dict(scope["headers"]).get(b"authorization")
+        seen.append((scope["method"], auth))
+        if auth != b"Bearer s3cret":
+            return await PlainTextResponse("no", 401)(scope, receive, send)
+    await inner(scope, receive, send)
+
+
+sock = socket.socket()
+sock.bind(("127.0.0.1", 0))
+port = sock.getsockname()[1]
+sock.close()
+uv = uvicorn.Server(uvicorn.Config(app, port=port, log_level="warning"))
+threading.Thread(target=uv.run, daemon=True).start()
+while not uv.started:
+    time.sleep(0.05)
+
+print(anyio.run(search_remote, f"http://127.0.0.1:{port}/mcp", "s3cret", "Onboarding"))
+time.sleep(0.3)
+print(seen)
+assert seen and all(a == b"Bearer s3cret" for _, a in seen)
+uv.should_exit = True
