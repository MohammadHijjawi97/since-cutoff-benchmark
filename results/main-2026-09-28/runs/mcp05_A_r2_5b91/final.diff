--- /dev/null
+++ b/_smoke_remote.py
@@ -0,0 +1,42 @@
+import threading
+import time
+
+import anyio
+import uvicorn
+from mcp.server.mcpserver import MCPServer
+
+from kb.remote import search_remote
+
+server = MCPServer("kb")
+
+
+@server.tool()
+def search(query: str) -> str:
+    return f"Result for {query}\n\n  Onboarding \n"
+
+
+seen = []
+inner = server.streamable_http_app()
+
+
+async def app(scope, receive, send):
+    if scope["type"] == "http":
+        headers = dict(scope["headers"])
+        seen.append((scope["method"], headers.get(b"authorization")))
+    await inner(scope, receive, send)
+
+
+config = uvicorn.Config(app, host="127.0.0.1", port=8765, log_level="warning")
+srv = uvicorn.Server(config)
+threading.Thread(target=srv.run, daemon=True).start()
+while not srv.started:
+    time.sleep(0.05)
+
+titles = anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "s3cret", "api keys")
+print("titles:", titles)
+for method, auth in seen:
+    print(method, auth)
+assert titles == ["Result for api keys", "Onboarding"]
+assert seen and all(auth == b"Bearer s3cret" for _, auth in seen)
+print("OK")
+srv.should_exit = True
