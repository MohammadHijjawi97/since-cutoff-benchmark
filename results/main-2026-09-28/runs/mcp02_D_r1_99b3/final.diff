+from typing import Any
+
+import anyio
+import pytest
+from mcp import types
+
+from opsbot.calls import ToolCallFailed, run_tool
+
+
+class FakeSession:
+    def __init__(self, result: types.CallToolResult) -> None:
+        self.result = result
+        self.calls: list[tuple[str, dict[str, Any]]] = []
+
+    async def call_tool(self, name: str, arguments: dict[str, Any]) -> types.CallToolResult:
+        self.calls.append((name, arguments))
+        return self.result
+
+
+def text(*lines: str) -> list[types.ContentBlock]:
+    return [types.TextContent(type="text", text=line) for line in lines]
+
+
+def call(result: types.CallToolResult) -> Any:
+    session = FakeSession(result)
+
+    async def go() -> Any:
+        return await run_tool(session, "deploy", {"version": "4.3.0"})  # type: ignore[arg-type]
+
+    value = anyio.run(go)
+    assert session.calls == [("deploy", {"version": "4.3.0"})]
+    return value
+
+
+def test_error_raises_with_joined_text():
+    with pytest.raises(ToolCallFailed) as info:
+        call(types.CallToolResult(content=text("no such", "version"), is_error=True))
+    assert (info.value.tool, info.value.message) == ("deploy", "no such\nversion")
+
+
+def test_structured_content_returned_as_is():
+    assert call(types.CallToolResult(content=text("ignored"), structured_content={"ok": True})) == {"ok": True}
+    assert call(types.CallToolResult(content=text("ignored"), structured_content=[])) == []
+
+
+def test_text_blocks_joined():
+    assert call(types.CallToolResult(content=text("a", "b"))) == "a\nb"
