@@ -0,0 +1,21 @@
+import openai
+import pytest
+
+from app import digest
+from tests.fakes import mock_openai
+
+
+def test_pre_and_post():
+    before = openai.OpenAI(api_key="x", max_retries=0)
+    digest.get_client()
+    with mock_openai("a", "b") as seen:
+        inside = openai.OpenAI(api_key="x", max_retries=0)
+        for c in (before, inside):
+            r = c.chat.completions.create(model="m", messages=[{"role": "user", "content": "hi"}])
+            assert r.choices[0].message.content in ("a", "b")
+        with pytest.raises(openai.BadRequestError):
+            inside.chat.completions.create(model="m", messages=[])
+    assert len(seen) == 3
+    with pytest.raises(Exception) as e:
+        before.chat.completions.create(model="m", messages=[])
+    assert not isinstance(e.value, openai.BadRequestError)
