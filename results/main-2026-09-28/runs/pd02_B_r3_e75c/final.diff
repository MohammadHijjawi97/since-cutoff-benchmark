 import pandas as pd
 
 
+def _format_amount(value: object) -> str:
+    """Accounting style: 1,234.50, negatives in parentheses, zero as "-", missing as ""."""
+    if pd.isna(value):
+        return ""
+    amount = round(float(value), 2)
+    if amount == 0:
+        # Also covers float noise such as 1e-13 or -0.004 that would print as "0.00" / "(0.00)".
+        return "-"
+    text = f"{abs(amount):,.2f}"
+    return f"({text})" if amount < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
