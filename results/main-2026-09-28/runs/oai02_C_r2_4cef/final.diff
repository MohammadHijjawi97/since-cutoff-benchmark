@@ -0,0 +1,20 @@
+import openai
+import pytest
+
+from tests.fakes import mock_openai
+
+MSGS = [{"role": "user", "content": "hi"}]
+
+
+def test_contract():
+    early = openai.OpenAI(api_key="x", max_retries=0)
+    with mock_openai("one") as seen:
+        late = openai.OpenAI(api_key="x", max_retries=0)
+        r = early.chat.completions.create(model="m", messages=MSGS)
+        assert r.choices[0].message.content == "one"
+        with pytest.raises(openai.BadRequestError):
+            late.chat.completions.create(model="m", messages=MSGS)
+    assert len(seen) == 2
+    with pytest.raises(Exception) as exc:
+        early.chat.completions.create(model="m", messages=MSGS)
+    print(type(exc.value), repr(exc.value.__cause__))
