 """Cleaning step of the orders ETL."""
 
 import pandas as pd
+from pandas.api.types import is_object_dtype, is_string_dtype
+
+
+def _strip_text(s: pd.Series) -> pd.Series:
+    """Strip whitespace from the strings in ``s`` and blank out empty ones.
+
+    Non-string values in object columns are left untouched (``Series.str``
+    would turn them into NaN).
+    """
+    if is_object_dtype(s.dtype):
+        stripped = s.map(lambda v: v.strip() if isinstance(v, str) else v)
+        empty = stripped.map(lambda v: isinstance(v, str) and v == "").astype(bool)
+    else:
+        stripped = s.str.strip()
+        empty = stripped.eq("").fillna(False).astype(bool)
+    return stripped.mask(empty)
 
 
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A cleaned copy of the orders frame; ``df`` itself is not modified."""
+    out = df.copy()
+    for col in out.columns:
+        dtype = out[col].dtype
+        if is_object_dtype(dtype) or (is_string_dtype(dtype) and not isinstance(dtype, pd.CategoricalDtype)):
+            out[col] = _strip_text(out[col])
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+    return out
