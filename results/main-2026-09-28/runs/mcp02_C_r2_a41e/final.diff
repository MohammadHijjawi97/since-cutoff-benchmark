@@ -0,0 +1,28 @@
+import anyio
+from mcp.types import CallToolResult, TextContent, ImageContent
+from opsbot.calls import run_tool, ToolCallFailed
+
+
+class Fake:
+    def __init__(self, r):
+        self.r = r
+
+    async def call_tool(self, name, arguments):
+        return self.r
+
+
+async def main():
+    t = [TextContent(type="text", text="a"), ImageContent(type="image", data="", mime_type="image/png"), TextContent(type="text", text="b")]
+    assert await run_tool(Fake(CallToolResult(content=t)), "x", {}) == "a\nb"
+    assert await run_tool(Fake(CallToolResult(content=t, structured_content={"k": 1})), "x", {}) == {"k": 1}
+    assert await run_tool(Fake(CallToolResult(content=t, structured_content=[])), "x", {}) == []
+    try:
+        await run_tool(Fake(CallToolResult(content=t, is_error=True, structured_content={"k": 1})), "deploy", {})
+    except ToolCallFailed as e:
+        assert (e.tool, e.message) == ("deploy", "a\nb")
+    else:
+        raise AssertionError
+    print("ok")
+
+
+anyio.run(main)
