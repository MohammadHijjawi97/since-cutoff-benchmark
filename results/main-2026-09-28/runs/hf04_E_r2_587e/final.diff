+import logging
+
+import httpx2
+from huggingface_hub import HfApi
+from huggingface_hub.errors import RepositoryNotFoundError
+
+from app.network import configure_hub_http, current_revision
+
+logging.basicConfig()
+seen = []
+
+
+def ok(req):
+    seen.append(req)
+    return httpx2.Response(200, json={"id": "a/b", "sha": "deadbeef"})
+
+
+configure_hub_http(httpx2.MockTransport(ok))
+print(current_revision("a/b"), HfApi().model_info("a/b").sha)
+r = seen[0]
+print(r.url, r.headers["x-acme-job"], r.headers["user-agent"][:30], r.extensions["timeout"])
+
+
+def boom(req):
+    raise httpx2.ConnectError("down", request=req)
+
+
+def slow(req):
+    raise httpx2.ReadTimeout("slow", request=req)
+
+
+def nf(req):
+    return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, json={"error": "nope"})
+
+
+configure_hub_http(httpx2.MockTransport(boom))
+print(current_revision("a/b"))
+configure_hub_http(httpx2.MockTransport(slow))
+print(current_revision("a/b"))
+configure_hub_http(httpx2.MockTransport(nf))
+try:
+    current_revision("a/b")
+except RepositoryNotFoundError as e:
+    print("raised", type(e).__name__)
