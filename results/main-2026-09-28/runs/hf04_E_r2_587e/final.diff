+class _HubClient(httpx2.Client):
+    """Client whose timeouts cannot be switched off per request.
+
+    Several HfApi methods (model_info, dataset_info, ...) pass `timeout=None` by default, which httpx2 treats as
+    "no timeout at all" instead of "use the client's timeout".
+    """
