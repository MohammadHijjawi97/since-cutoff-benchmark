@@ -0,0 +1,27 @@
+import logging
+
+import httpx
+
+from app.llm_client import build_client
+
+
+def test_build_client_retries_logs_and_timeouts(caplog, monkeypatch):
+    monkeypatch.setattr("time.sleep", lambda _: None)
+    seen = []
+
+    def handler(request):
+        seen.append(request)
+        if len(seen) < 3:
+            return httpx.Response(500, json={})
+        return httpx.Response(200, json={"object": "list", "data": []})
+
+    client = build_client("test-key", transport=httpx.MockTransport(handler))
+
+    with caplog.at_level(logging.INFO, logger="app.http"):
+        client.models.list()
+
+    assert client.max_retries == 2
+    assert len(seen) == 3
+    assert seen[0].extensions["timeout"] == {"connect": 5.0, "read": 30.0, "write": 30.0, "pool": 30.0}
+    messages = [r.getMessage() for r in caplog.records if r.name == "app.http"]
+    assert messages == ["GET https://api.openai.com/v1/models"] * 3
