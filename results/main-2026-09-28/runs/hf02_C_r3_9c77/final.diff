     return info.commit_url
 
 
-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`, skipping `*.tmp` and `wandb/`.
+
+    With hf_xet (a dependency of huggingface_hub), `upload_folder` splits large folders into several commits and
+    resumes an interrupted upload when called again: files already committed are skipped.
+    """
+    api = api or HfApi()
+    run_dir = Path(run_dir)
+    api.create_repo(repo_id=repo_id, repo_type="dataset", private=True, exist_ok=True)
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=run_dir,
+        ignore_patterns=["*.tmp", "wandb/*"],
+        commit_message=f"Upload run {run_dir.name}",
+    )
