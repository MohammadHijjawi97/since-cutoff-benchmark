+
+
+class FolderRecordingApi:
+    def __init__(self):
+        self.calls = []
+
+    def create_repo(self, **kwargs):
+        self.calls.append(("create_repo", kwargs))
+
+    def upload_folder(self, **kwargs):
+        self.calls.append(("upload_folder", kwargs))
+
+
+def test_publish_run_creates_private_repo_and_uploads_folder(tmp_path):
+    api = FolderRecordingApi()
+
+    publish_run(tmp_path, "acme-ml/run-0007", api=api)
+
+    (create_name, create), (upload_name, upload) = api.calls
+    assert create_name == "create_repo" and upload_name == "upload_folder"
+    assert create["repo_id"] == "acme-ml/run-0007" and create["repo_type"] == "dataset"
+    assert create["private"] is True and create["exist_ok"] is True
+    assert upload["repo_id"] == "acme-ml/run-0007" and upload["repo_type"] == "dataset"
+    assert upload["folder_path"] == tmp_path and upload.get("path_in_repo") is None
+    assert set(upload["ignore_patterns"]) == {"*.tmp", "wandb/*"}
