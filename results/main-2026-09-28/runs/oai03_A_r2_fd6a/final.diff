 def test_build_messages_keeps_history_in_order():
@@ -27,3 +34,89 @@
     assert list(chat.iter_answer(client, "How do I log in?")) == ["Reset ", "your password"]
     assert completions.calls[0]["stream"] is True
     assert completions.calls[0]["model"] == chat.MODEL
+
+
+# --- answer(): a real OpenAI client over a transport that misbehaves on cue ---
+
+
+def sse(*deltas):
+    for d in deltas:
+        chunk = {
+            "id": "c",
+            "object": "chat.completion.chunk",
+            "created": 0,
+            "model": chat.MODEL,
+            "choices": [{"index": 0, "delta": {"content": d}, "finish_reason": None}],
+        }
+        yield f"data: {json.dumps(chunk)}\n\n".encode()
+
+
+class Body(httpx2.SyncByteStream):
+    def __init__(self, parts, then_raise=None):
+        self.parts, self.then_raise = list(parts), then_raise
+
+    def __iter__(self):
+        yield from self.parts
+        if self.then_raise:
+            raise self.then_raise
+        yield b"data: [DONE]\n\n"
+
+
+def make_client(*behaviours):
+    """Each behaviour is an exception raised at connect time or a Body to stream back."""
+    calls = []
+
+    def handler(request):
+        calls.append(request)
+        behaviour = behaviours[len(calls) - 1]
+        if isinstance(behaviour, Exception):
+            raise behaviour
+        return httpx2.Response(200, headers={"content-type": "text/event-stream"}, stream=behaviour)
+
+    http = httpx2.Client(transport=httpx2.MockTransport(handler))
+    return OpenAI(api_key="test", base_url="http://llm.test/v1", http_client=http, max_retries=0), calls
+
+
+DROP = "peer closed connection without sending complete message body"
+
+
+def test_answer_returns_full_text_on_first_try():
+    client, calls = make_client(Body(sse("Hello ", "there")))
+    assert chat.answer(client, "Hi?") == "Hello there"
+    assert len(calls) == 1
+
+
+def test_answer_retries_mid_stream_drop_without_keeping_fragments(caplog):
+    client, calls = make_client(
+        Body(sse("Partial ", "ans"), then_raise=httpx2.RemoteProtocolError(DROP)),
+        httpx2.ConnectError("connection reset by peer"),
+        Body(sse("Complete ", "answer")),
+    )
+    with caplog.at_level(logging.WARNING, logger="app.chat"):
+        assert chat.answer(client, "Q?", iter([("a", "b")])) == "Complete answer"
+    assert len(calls) == 3
+    warnings = [r for r in caplog.records if r.name == "app.chat" and r.levelno == logging.WARNING]
+    assert len(warnings) == 2
+    assert DROP in warnings[0].getMessage()
+    assert "connection reset by peer" in warnings[1].getMessage()
+    # a one-shot history iterator is still re-sent intact on the retry
+    assert len(json.loads(calls[2].content)["messages"]) == 4
+
+
+def test_answer_raises_unavailable_after_all_attempts_fail(caplog):
+    client, calls = make_client(*[httpx2.RemoteProtocolError(DROP) for _ in range(chat.ATTEMPTS)])
+    with caplog.at_level(logging.WARNING, logger="app.chat"):
+        with pytest.raises(UpstreamUnavailable):
+            chat.answer(client, "Q?")
+    assert len(calls) == chat.ATTEMPTS
+    assert sum(DROP in r.getMessage() for r in caplog.records) == chat.ATTEMPTS
+
+
+def test_answer_does_not_retry_timeouts():
+    client, calls = make_client(
+        Body(sse("Slow "), then_raise=httpx2.ReadTimeout("timed out")),
+        Body(sse("never used")),
+    )
+    with pytest.raises(UpstreamTimeout):
+        chat.answer(client, "Q?")
+    assert len(calls) == 1
