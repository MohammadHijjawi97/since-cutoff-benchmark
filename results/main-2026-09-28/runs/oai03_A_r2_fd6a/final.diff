 def answer(client: OpenAI, question: str, history: Iterable[tuple[str, str]] = ()) -> str:
-    """The complete answer to `question` (used by the e-mail channel)."""
-    raise NotImplementedError
+    """The complete answer to `question` (used by the e-mail channel).
+
+    Connection failures and mid-stream drops restart the request from scratch, up to
+    ATTEMPTS attempts in total; a timeout is not retried.
+    """
+    history = list(history)  # may be iterated once per attempt
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            # Collect into a fresh list so a dropped attempt leaves no fragments behind.
+            return "".join(list(iter_answer(client, question, history)))
+        except APITimeoutError as err:  # subclass of APIConnectionError, so check it first
+            raise UpstreamTimeout(str(err.__cause__ or err)) from err
+        except APIConnectionError as err:
+            # The SDK's own message is just "Connection error."; the network error it
+            # wraps (e.g. "peer closed connection ...") is what ops need to see.
+            logger.warning(
+                "Attempt %d/%d to reach the model provider failed: %s",
+                attempt,
+                ATTEMPTS,
+                err.__cause__ or err,
+            )
+            last_error = err
+    raise UpstreamUnavailable(f"model provider unreachable after {ATTEMPTS} attempts") from last_error
