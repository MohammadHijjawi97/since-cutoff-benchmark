+def build_httpx2_client(transport=None) -> httpx2.Client:
+    """The same egress settings on an httpx2 client, for SDKs built on httpx2 (anthropic)."""
+    return httpx2.Client(
+        timeout=httpx2.Timeout(READ_TIMEOUT, connect=CONNECT_TIMEOUT),
+        headers={"X-Egress-Tag": EGRESS_TAG},
+        event_hooks={"request": [log_egress]},
+        transport=transport,
+    )
