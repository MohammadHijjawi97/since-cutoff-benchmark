+import logging
+
+import httpx2
+
+from app.claude import ask, build_claude
+
+logging.basicConfig(level=logging.INFO, format="%(name)s %(message)s")
+seen = []
+
+
+def handler(req):
+    seen.append(req)
+    if len(seen) == 1:
+        return httpx2.Response(500, json={"type": "error", "error": {"type": "api_error", "message": "x"}})
+    return httpx2.Response(200, json={
+        "id": "m", "type": "message", "role": "assistant", "model": "claude-opus-5-5",
+        "content": [{"type": "text", "text": "ok"}], "stop_reason": "end_turn", "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 1},
+    })
+
+
+c = build_claude("k", transport=httpx2.MockTransport(handler))
+print(ask(c, "hi"), len(seen), [r.headers.get("x-egress-tag") for r in seen])
+print(seen[-1].extensions.get("timeout"), c.max_retries)
