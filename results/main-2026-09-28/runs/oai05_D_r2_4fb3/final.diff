+import logging
+
+import httpx
+
+logging.basicConfig(level=logging.INFO, format="%(name)s %(levelname)s %(message)s")
+from app.llm_client import build_client
+from app.search import rewrite_query
+
+calls = {"n": 0}
+
+
+def handler(req):
+    calls["n"] += 1
+    if calls["n"] == 1:
+        return httpx.Response(500, json={"error": {"message": "boom"}})
+    return httpx.Response(200, json={
+        "id": "r", "object": "response", "created_at": 0, "model": "m", "status": "completed",
+        "output": [{"type": "message", "id": "m", "role": "assistant", "status": "completed",
+                    "content": [{"type": "output_text", "text": " q ", "annotations": []}]}],
+        "parallel_tool_calls": False, "tool_choice": "auto", "tools": [],
+    })
+
+
+c = build_client("k", transport=httpx.MockTransport(handler))
+print("timeout:", c.timeout, c._client.timeout, "retries:", c.max_retries)
+print("result:", repr(rewrite_query(c, "hi")), "calls:", calls["n"])
