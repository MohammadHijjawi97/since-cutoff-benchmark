@@ -0,0 +1,32 @@
+import anyio
+from mcp.server.mcpserver import MCPServer
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+
+
+def make_server() -> MCPServer:
+    server = MCPServer("demo")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"Hello, {name}!"
+
+    return server
+
+
+def test_check_server_passes():
+    cases = [Case("add", {"a": 2, "b": 3}, "5"), Case("greet", {"name": "Ada"}, "Hello, Ada!")]
+    assert anyio.run(check_server, make_server(), cases) == []
+
+
+def test_check_server_reports_mismatches_in_order():
+    wrong_add = Case("add", {"a": 2, "b": 2}, "5")
+    right = Case("greet", {"name": "Ada"}, "Hello, Ada!")
+    wrong_greet = Case("greet", {"name": "Bob"}, "Hi Bob")
+    mismatches = anyio.run(check_server, make_server(), [wrong_add, right, wrong_greet])
+    assert mismatches == [Mismatch(wrong_add, "4"), Mismatch(wrong_greet, "Hello, Bob!")]
