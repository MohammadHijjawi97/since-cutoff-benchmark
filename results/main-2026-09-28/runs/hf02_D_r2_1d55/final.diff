+
+def test_publish_run_creates_private_repo_and_uploads_folder_at_root(tmp_path):
+    run = tmp_path / "run-0007"
+    run.mkdir()
+    api = RecordingApi()
+
+    publish_run(run, "acme-ml/run-0007", api=api)
+
+    create, upload = api.calls
+    assert create == ("create_repo", "acme-ml/run-0007", {"repo_type": "dataset", "private": True, "exist_ok": True})
+    _, kwargs = upload
+    assert kwargs["repo_id"] == "acme-ml/run-0007" and kwargs["repo_type"] == "dataset"
+    assert kwargs["folder_path"] == run
+    assert kwargs.get("path_in_repo") in (None, "")
+
+
+def test_publish_run_ignore_patterns_skip_tmp_files_and_wandb(tmp_path):
+    api = RecordingApi()
+    publish_run(tmp_path, "acme-ml/run-0007", api=api)
+    _, kwargs = api.calls[1]
+
+    paths = [
+        "metrics.json",
+        "checkpoints/step-100/model.safetensors",
+        "checkpoints/step-100/model.safetensors.tmp",
+        "shard.tmp",
+        "wandb/run-1/files/output.log",
+        "data/wandb-notes.txt",
+    ]
+    kept = list(filter_repo_objects(paths, ignore_patterns=kwargs["ignore_patterns"]))
+    assert kept == ["metrics.json", "checkpoints/step-100/model.safetensors", "data/wandb-notes.txt"]
