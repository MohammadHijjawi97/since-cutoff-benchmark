 import pandas as pd
 
 
+def _accounting(value: object) -> str:
+    """Format one amount in accounting style: 1,234.50 / (1,234.50) / - / empty."""
+    if pd.isna(value):
+        return ""
+    amount = round(float(value), 2)
+    if amount == 0:
+        return "-"
+    text = f"{abs(amount):,.2f}"
+    return f"({text})" if amount < 0 else text
+
+
