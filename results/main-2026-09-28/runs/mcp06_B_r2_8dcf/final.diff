+import sys
+
+import anyio
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+from mcpcheck.stdio import check_command
+
+SERVER_SOURCE = '''
+from mcp.server.mcpserver import MCPServer
+
+server = MCPServer("demo")
+
+
+@server.tool()
+def add(a: int, b: int) -> int:
+    return a + b
+
+
+@server.tool()
+def greet(name: str) -> str:
+    return f"Hi {name}"
+
+
+@server.tool()
+def boom() -> str:
+    raise ValueError("kaput")
+
+
+if __name__ == "__main__":
+    server.run()
+'''
+
+CASES = [
+    Case("add", {"a": 2, "b": 3}, "5"),
+    Case("greet", {"name": "Ada"}, "Hello, Ada!"),
+    Case("add", {"a": 1, "b": 1}, "3"),
+    Case("boom", {}, "ok"),
+    Case("missing", {}, "nothing"),
+]
+
+
+def build_server():
+    namespace: dict = {}
+    exec(SERVER_SOURCE, namespace)
+    return namespace["server"]
+
+
+def test_check_server_reports_mismatches_in_order():
+    mismatches = anyio.run(check_server, build_server(), CASES)
+    assert [m.case for m in mismatches] == CASES[1:]
+    assert mismatches[0] == Mismatch(CASES[1], "Hi Ada")
+    assert mismatches[1] == Mismatch(CASES[2], "2")
+
+
+def test_check_server_all_pass():
+    assert anyio.run(check_server, build_server(), CASES[:1]) == []
+
+
+def test_check_server_matches_check_command(tmp_path):
+    script = tmp_path / "server.py"
+    script.write_text(SERVER_SOURCE)
+    over_stdio = anyio.run(check_command, [sys.executable, str(script)], CASES)
+    in_process = anyio.run(check_server, build_server(), CASES)
+    assert in_process == over_stdio
