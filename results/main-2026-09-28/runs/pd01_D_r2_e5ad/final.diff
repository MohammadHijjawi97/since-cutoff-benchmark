 import pandas as pd
 
 
+def _is_text(dtype) -> bool:
+    # pandas 3 stores text in the "str" dtype by default, but object columns
+    # can still show up (e.g. frames built by hand), so accept both.
+    return isinstance(dtype, pd.StringDtype) or pd.api.types.is_object_dtype(dtype)
+
+
+def _clean_text(s: pd.Series) -> pd.Series:
+    # Only touch actual strings, so non-string values in object columns survive.
+    s = s.map(lambda v: v.strip() if isinstance(v, str) else v)
+    empty = s.map(lambda v: isinstance(v, str) and v == "").astype(bool)
+    return s.mask(empty)
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A copy of the orders frame with tidied text and missing quantities set to 0."""
+    out = df.copy()
+    for col in out.columns:
+        if _is_text(out[col].dtype):
+            out[col] = _clean_text(out[col])
+    if "qty" in out.columns:
+        out["qty"] = out["qty"].fillna(0)
+    return out
