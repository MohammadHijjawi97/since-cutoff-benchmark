 import pandas as pd
 
 
+def _accounting(value: object) -> str:
+    """Format one amount in accounting style: 1,234.50 / (634.20) / - / ""."""
+    if pd.isna(value):
+        return ""
+    # Round to cents first so float noise from summing (e.g. 1e-13) shows as zero, not "(0.00)".
+    amount = round(float(value), 2)
+    if amount == 0:
+        return "-"
+    text = f"{abs(amount):,.2f}"
+    return f"({text})" if amount < 0 else text
+
+
 def format_for_display(table: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Return a copy of the account x month table with every cell as an accounting-style string."""
+    return table.map(_accounting)
