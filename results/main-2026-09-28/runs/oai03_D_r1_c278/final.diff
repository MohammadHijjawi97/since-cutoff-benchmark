+    """The complete answer to `question` (used by the e-mail channel).
+
+    A failed or dropped connection restarts the whole request, up to ATTEMPTS times; a timeout
+    is not retried.
+    """
+    history = list(history)  # iterated once per attempt
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            return "".join(iter_answer(client, question, history))
+        except APITimeoutError as err:
+            raise UpstreamTimeout(_network_error(err)) from err
+        except APIConnectionError as err:
+            # The SDK's message is always "Connection error."; the network error is its cause.
+            logger.warning("Attempt %d/%d failed: %s", attempt, ATTEMPTS, _network_error(err))
+            last_error = err
+    raise UpstreamUnavailable(f"No answer after {ATTEMPTS} attempts") from last_error
+
+
+def _network_error(err: APIConnectionError) -> str:
+    cause = err.__cause__
+    return f"{type(cause).__name__}: {cause}" if cause is not None else str(err)
