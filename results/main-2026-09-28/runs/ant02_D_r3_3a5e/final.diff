@@ -0,0 +1,40 @@
+import json
+
+import httpx2
+from anthropic import Anthropic, DefaultHttpxClient
+
+from app.audit import ask_with_audit
+
+BODY = json.dumps(
+    {
+        "id": "msg_1",
+        "type": "message",
+        "role": "assistant",
+        "model": "claude-opus-5-5",
+        "content": [{"type": "text", "text": "Hel"}, {"type": "text", "text": "lo"}],
+        "stop_reason": "end_turn",
+        "stop_sequence": None,
+        "usage": {"input_tokens": 1, "output_tokens": 2},
+    }
+)
+
+
+def test_ask_with_audit_keeps_raw_exchange():
+    sent = {}
+
+    def handler(request):
+        sent.update(json.loads(request.content))
+        return httpx2.Response(
+            200,
+            headers={"request-id": "req_abc", "content-type": "application/json"},
+            content=BODY.encode(),
+        )
+
+    client = Anthropic(
+        api_key="test", http_client=DefaultHttpxClient(transport=httpx2.MockTransport(handler))
+    )
+    result = ask_with_audit(client, "hi")
+
+    assert result == {"request_id": "req_abc", "raw_body": BODY, "answer": "Hello"}
+    assert sent["max_tokens"] == 256
+    assert sent["messages"] == [{"role": "user", "content": "hi"}]
