 from mcpcheck.cases import Case, Mismatch, compare
 
 
+async def check_session(session: ClientSession, cases: list[Case]) -> list[Mismatch]:
+    """Initialize `session`, call every case's tool in order and return the mismatches."""
+    mismatches: list[Mismatch] = []
+    await session.initialize()
+    for case in cases:
+        result = await session.call_tool(case.tool, case.arguments)
+        mismatch = compare(case, result)
+        if mismatch is not None:
+            mismatches.append(mismatch)
+    return mismatches
