@@ -0,0 +1,30 @@
+import anyio
+from mcp.server import MCPServer
+
+from mcpcheck.cases import Case, Mismatch, load_cases
+from mcpcheck.inproc import check_server
+
+from test_cases import EXAMPLES
+
+
+def make_server(greeting: str) -> MCPServer:
+    server = MCPServer("demo")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"{greeting}, {name}!"
+
+    return server
+
+
+def test_check_server_passes():
+    assert anyio.run(check_server, make_server("Hello"), load_cases(EXAMPLES)) == []
+
+
+def test_check_server_reports_mismatches():
+    mismatches = anyio.run(check_server, make_server("Hi"), load_cases(EXAMPLES))
+    assert mismatches == [Mismatch(Case("greet", {"name": "Ada"}, "Hello, Ada!"), "Hi, Ada!")]
