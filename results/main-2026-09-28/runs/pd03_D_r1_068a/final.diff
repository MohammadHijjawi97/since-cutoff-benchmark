--- a/app/gaps.py
+++ b/app/gaps.py
@@ -6,4 +6,20 @@
 
 
 def fill_gaps(readings: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """Fill missing ``temp_c`` values from the same station only.
+
+    A gap takes the most recent earlier temperature of its station, or, if the
+    station has none yet, the first later one. Stations without any temperature
+    (and rows without a station) keep their missing values.
+    """
+    filled = readings.copy()
+    temps = filled["temp_c"]
+    # Group by position so a duplicated or unsorted index cannot misalign rows.
+    by_station = temps.reset_index(drop=True).groupby(
+        filled["station"].reset_index(drop=True), sort=False
+    )
+    candidates = by_station.ffill().fillna(by_station.bfill())
+    # Rows with a missing station fall outside every group and come back as NaN;
+    # only ever write into gaps so existing temperatures are never touched.
+    filled["temp_c"] = temps.where(temps.notna(), candidates.to_numpy())
+    return filled
