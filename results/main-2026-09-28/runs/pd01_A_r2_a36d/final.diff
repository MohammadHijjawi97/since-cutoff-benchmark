 import pandas as pd
 
 
+def _clean_text(s: pd.Series) -> pd.Series:
+    """Strip whitespace from the strings in ``s`` and turn empty strings into missing values."""
+    if isinstance(s.dtype, pd.StringDtype):
+        stripped = s.str.strip()
+    else:
+        # Object columns can hold non-string values; leave those untouched.
+        stripped = pd.Series(
+            [v.strip() if isinstance(v, str) else v for v in s],
+            index=s.index,
+            dtype=object,
+            name=s.name,
+        )
+    return stripped.mask(stripped.eq("").fillna(False).astype(bool))
+
+
 def clean_orders(df: pd.DataFrame) -> pd.DataFrame:
-    raise NotImplementedError
+    """A cleaned copy of the orders frame; ``df`` itself is left unchanged."""
+    out = df.copy()
+    for col in out.columns:
+        dtype = out[col].dtype
+        if dtype == object or isinstance(dtype, pd.StringDtype):
+            out[col] = _clean_text(out[col])
+    out["qty"] = out["qty"].fillna(0)
+    return out
