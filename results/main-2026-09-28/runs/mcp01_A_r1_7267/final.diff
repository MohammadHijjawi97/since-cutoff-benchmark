+import sys
+
+import anyio
+from mcp import ClientSession, StdioServerParameters
+from mcp.client.stdio import stdio_client
+
+
+async def main():
+    p = StdioServerParameters(command=sys.executable, args=["-m", "app.server"])
+    async with stdio_client(p) as (r, w):
+        async with ClientSession(r, w) as s:
+            await s.initialize()
+            calls = [
+                ("add_note", {"title": "a", "body": "one two  three\nfour"}),
+                ("word_count", {"title": "a"}),
+                ("word_count", {"title": "zz"}),
+            ]
+            for name, args in calls:
+                res = await s.call_tool(name, args)
+                print(name, res.is_error, [c.text for c in res.content], res.structured_content)
+
+
+anyio.run(main)
