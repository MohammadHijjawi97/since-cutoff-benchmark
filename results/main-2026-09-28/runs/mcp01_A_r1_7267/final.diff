+def build_server() -> MCPServer:
+    server = MCPServer("notes")
+
+    @server.tool()
+    def add_note(title: str, body: str) -> str:
+        """Store a note under the given title."""
+        NOTES[title] = body
+        return f"saved {title}"
+
+    @server.tool()
+    def word_count(title: str) -> int:
+        """Return the number of whitespace-separated words in a stored note."""
+        if title not in NOTES:
+            # ToolError reaches the model as is_error=True with this message;
+            # any other exception would be masked as "Error executing tool".
+            raise ToolError(f"no such note: {title!r}")
+        return len(NOTES[title].split())
+
