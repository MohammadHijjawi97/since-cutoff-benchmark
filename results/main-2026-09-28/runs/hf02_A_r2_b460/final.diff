-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`, skipping `*.tmp` and `wandb/`."""
+    api = api or HfApi()
+    api.create_repo(repo_id=repo_id, repo_type="dataset", private=True, exist_ok=True)
+    # With hf_xet installed (huggingface_hub>=2.0 replaces upload_large_folder), upload_folder commits
+    # large folders in batches and resumes an interrupted upload when re-run.
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=Path(run_dir),
+        ignore_patterns=["*.tmp", "wandb/*"],
+        commit_message=f"Upload run {Path(run_dir).name}",
+    )
