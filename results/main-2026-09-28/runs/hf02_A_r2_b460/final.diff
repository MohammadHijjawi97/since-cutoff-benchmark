+def test_publish_run_mirrors_the_run_folder_into_a_private_dataset(tmp_path):
+    run = tmp_path / "run-0007"
+    run.mkdir()
+    api = RecordingApi()
+
+    publish_run(run, "acme-ml/run-0007", api=api)
+
+    create, upload = api.calls
+    assert create == {"method": "create_repo", "repo_id": "acme-ml/run-0007", "repo_type": "dataset",
+                      "private": True, "exist_ok": True}
+    assert upload["method"] == "upload_folder"
+    assert upload["repo_id"] == "acme-ml/run-0007" and upload["repo_type"] == "dataset"
+    assert Path(upload["folder_path"]) == run and upload.get("path_in_repo") in (None, "")
+
