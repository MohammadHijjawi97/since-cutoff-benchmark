-    raise NotImplementedError
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`, creating the repo if needed.
+
+    With hf_xet, `upload_folder` commits large folders in several batches and resumes an interrupted
+    upload when called again (committed files are skipped, uploaded data is deduplicated).
+    """
+    if constants.HF_HUB_DISABLE_XET or not is_package_available("hf_xet"):
+        # Without hf_xet, upload_folder falls back to one huge, non-resumable commit.
+        raise RuntimeError("publish_run needs hf_xet enabled for batched, resumable uploads of large folders")
+    api = api or HfApi()
+    api.create_repo(repo_id, repo_type="dataset", private=True, exist_ok=True)
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=Path(run_dir),
+        ignore_patterns=list(RUN_IGNORE_PATTERNS),
+        commit_message=f"Upload run {Path(run_dir).name}",
+    )
