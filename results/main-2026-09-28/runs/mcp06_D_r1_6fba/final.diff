+import anyio
+from mcp.server import MCPServer
+
+from mcpcheck.cases import Case, Mismatch
+from mcpcheck.inproc import check_server
+
+
+def make_server() -> MCPServer:
+    server = MCPServer("demo")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"Hi {name}"
+
+    return server
+
+
+def test_check_server():
+    cases = [
+        Case("add", {"a": 2, "b": 3}, "5"),
+        Case("greet", {"name": "Ada"}, "Hello, Ada!"),
+        Case("add", {"a": 1, "b": 1}, "3"),
+    ]
+    mismatches = anyio.run(check_server, make_server(), cases)
+    assert mismatches == [Mismatch(cases[1], "Hi Ada"), Mismatch(cases[2], "2")]
