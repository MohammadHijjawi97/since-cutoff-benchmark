 def answer(client: OpenAI, question: str, history: Iterable[tuple[str, str]] = ()) -> str:
-    """The complete answer to `question` (used by the e-mail channel)."""
-    raise NotImplementedError
+    """The complete answer to `question` (used by the e-mail channel).
+
+    Retries the whole request, up to ATTEMPTS times, when the connection fails or drops
+    mid-stream. Raises UpstreamTimeout at once if the provider stops sending data, and
+    UpstreamUnavailable if every attempt fails.
+    """
+    history = list(history)  # may be a one-shot iterator, and each attempt needs it
+    for attempt in range(1, ATTEMPTS + 1):
+        try:
+            return "".join(iter_answer(client, question, history))
+        except APITimeoutError as err:  # subclass of APIConnectionError, so check it first
+            raise UpstreamTimeout(f"the model provider timed out: {_network_reason(err)}") from err
+        except APIConnectionError as err:
+            logger.warning("Answer attempt %d/%d failed: %s", attempt, ATTEMPTS, _network_reason(err))
+            last_error = err
+    raise UpstreamUnavailable(f"no answer after {ATTEMPTS} attempts") from last_error
