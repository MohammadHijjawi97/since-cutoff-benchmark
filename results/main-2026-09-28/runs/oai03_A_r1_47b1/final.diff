+def _network_reason(err: BaseException) -> str:
+    """The underlying network error's message; the SDK's own is just "Connection error."."""
+    reason = str(err)
+    cause = err.__cause__
+    while cause is not None:
+        if str(cause):
+            reason = str(cause)
+        cause = cause.__cause__
+    return reason
+
