+
+
+def _via_router(router: respx.Router):
+    """A stand-in for `httpx2.Client._transport_for_url` that answers requests from `router`."""
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        reply = router.handler(
+            httpx.Request(
+                request.method,
+                str(request.url),
+                headers=request.headers.raw,
+                content=request.read(),
+            )
+        )
+        return httpx2.Response(reply.status_code, headers=reply.headers.raw, content=reply.read())
+
+    def transport_for_url(self: httpx2.Client, url: httpx2.URL) -> httpx2.BaseTransport:
+        return httpx2.MockTransport(handle)
+
+    return transport_for_url
