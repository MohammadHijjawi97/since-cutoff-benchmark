@@ -0,0 +1,20 @@
+import openai
+import pytest
+from openai import OpenAI
+
+from tests.fakes import mock_openai
+
+MSG = [{"role": "user", "content": "hi"}]
+
+
+def test_contract():
+    before = OpenAI(api_key="x", max_retries=0)
+    with mock_openai("one") as seen:
+        inside = OpenAI(api_key="x", max_retries=0)
+        r = before.chat.completions.create(model="m", messages=MSG)
+        assert r.choices[0].message.content == "one"
+        with pytest.raises(openai.BadRequestError):
+            inside.chat.completions.create(model="m", messages=MSG)
+    assert len(seen) == 2
+    with pytest.raises(openai.APIConnectionError):
+        before.chat.completions.create(model="m", messages=MSG)
