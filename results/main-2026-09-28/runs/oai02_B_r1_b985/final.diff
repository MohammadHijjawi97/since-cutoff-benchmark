-        yield seen
+        # respx only patches httpx/httpcore, but openai>=3 sends through httpx2. Route every
+        # httpx2 client (whenever it was created) through the same router while the block runs.
+        with mock.patch.object(httpx2.Client, "_transport_for_url", _via_router(router)):
