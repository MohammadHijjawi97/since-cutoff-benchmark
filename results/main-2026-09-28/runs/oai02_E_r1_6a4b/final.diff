+import openai
+import pytest
+from openai import OpenAI
+
+from tests.fakes import mock_openai
+
+
+def test_mock_scope():
+    before = OpenAI(api_key="x", max_retries=0)
+    with mock_openai("one") as seen:
+        inside = OpenAI(api_key="x", max_retries=0)
+        assert before.chat.completions.create(model="m", messages=[]).choices[0].message.content == "one"
+        with pytest.raises(openai.BadRequestError):
+            inside.chat.completions.create(model="m", messages=[])
+    assert len(seen) == 2
+    with pytest.raises(openai.APIConnectionError):
+        before.chat.completions.create(model="m", messages=[])
