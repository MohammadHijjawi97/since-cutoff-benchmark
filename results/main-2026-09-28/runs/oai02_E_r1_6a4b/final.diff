+@contextmanager
+def _route_httpx2_through(router: respx.Router) -> Iterator[None]:
+    """Send every request of a sync `httpx2.Client` to `router` while the block is active.
+
+    Since openai 3.x the SDK talks HTTP through httpx2, which respx does not patch; respx
+    still covers legacy `httpx.Client` instances passed in as `http_client`. Patching the
+    class method (rather than a transport instance) also catches clients created earlier.
+    """
+
+    def handle(request: httpx2.Request) -> httpx2.Response:
+        # Router.handler raises AllMockedAssertionError for unrouted requests, like respx does.
+        response = router.handler(
+            httpx.Request(request.method, str(request.url), headers=request.headers.raw, content=request.content)
+        )
+        return httpx2.Response(response.status_code, headers=response.headers.raw, content=response.read())
+
+    transport = httpx2.MockTransport(handle)
+    with mock.patch.object(httpx2.Client, "_transport_for_url", lambda self, url: transport):
+        yield
