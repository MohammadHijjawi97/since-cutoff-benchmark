@@ -0,0 +1,42 @@
+from langchain_core.documents import Document
+
+from app.context import MAX_SOURCES, TRACE_TAG, build_context
+from app.kb import KeywordRetriever
+
+
+def doc(source: str, text: str) -> Document:
+    return Document(page_content=text, metadata={"source": source})
+
+
+def test_one_entry_per_source_in_retriever_order():
+    docs = [
+        doc("a.md", "  alpha vpn\n"),
+        doc("a.md", "vpn again"),
+        doc("b.md", "\nbeta vpn  "),
+    ]
+    retriever = KeywordRetriever(docs=docs)
+    assert build_context(retriever, "vpn") == "[1] a.md\nalpha vpn\n\n[2] b.md\nbeta vpn"
+
+
+def test_at_most_max_sources():
+    docs = [doc(f"{i}.md", "vpn") for i in range(MAX_SOURCES + 2)]
+    context = build_context(KeywordRetriever(docs=docs, k=10), "vpn")
+    assert context.count("\n\n") == MAX_SOURCES - 1
+    assert f"[{MAX_SOURCES}] {MAX_SOURCES - 1}.md" in context
+    assert f"[{MAX_SOURCES + 1}]" not in context
+
+
+def test_empty_when_nothing_found():
+    assert build_context(KeywordRetriever(docs=[doc("a.md", "vpn")]), "kubernetes") == ""
+
+
+def test_lookup_carries_trace_tag():
+    seen_tags = []
+
+    class RecordingRetriever(KeywordRetriever):
+        def _get_relevant_documents(self, query, *, run_manager):
+            seen_tags.append(run_manager.tags)
+            return super()._get_relevant_documents(query, run_manager=run_manager)
+
+    build_context(RecordingRetriever(docs=[doc("a.md", "vpn")]), "vpn")
+    assert seen_tags and TRACE_TAG in seen_tags[0]
