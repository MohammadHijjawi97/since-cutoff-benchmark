@@ -0,0 +1,40 @@
+from pathlib import Path
+
+import anyio
+from mcp.server.mcpserver import MCPServer
+
+from mcpcheck.cases import Case, Mismatch, load_cases
+from mcpcheck.inproc import check_server
+
+EXAMPLES = Path(__file__).resolve().parent.parent / "examples" / "cases.toml"
+
+
+def make_server(greeting: str = "Hello") -> MCPServer:
+    server = MCPServer("example")
+
+    @server.tool()
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    @server.tool()
+    def greet(name: str) -> str:
+        return f"{greeting}, {name}!"
+
+    return server
+
+
+def test_check_server_passes():
+    assert anyio.run(check_server, make_server(), load_cases(EXAMPLES)) == []
+
+
+def test_check_server_reports_mismatches_in_order():
+    cases = [
+        Case("greet", {"name": "Ada"}, "Hello, Ada!"),
+        Case("add", {"a": 2, "b": 3}, "6"),
+        Case("greet", {"name": "Bob"}, "Hello, Bob!"),
+    ]
+    assert anyio.run(check_server, make_server("Hi"), cases) == [
+        Mismatch(cases[0], "Hi, Ada!"),
+        Mismatch(cases[1], "5"),
+        Mismatch(cases[2], "Hi, Bob!"),
+    ]
