-def publish_run(run_dir: str | Path, repo_id: str) -> None:
-    raise NotImplementedError
+RUN_IGNORE_PATTERNS = ["*.tmp", "wandb/*"]  # fnmatch-style: `*` also matches across `/`
+
+
+def publish_run(run_dir: str | Path, repo_id: str, api: HfApi | None = None) -> None:
+    """Mirror `run_dir` at the root of the private dataset repo `repo_id`, creating the repo if needed.
+
+    With `hf_xet` installed (a huggingface_hub dependency), `upload_folder` commits large folders in
+    several batches and resumes an interrupted upload when called again, skipping files already on the Hub.
+    """
+    api = api or HfApi()
+    run_dir = Path(run_dir)
+    api.create_repo(repo_id=repo_id, repo_type="dataset", private=True, exist_ok=True)
+    api.upload_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=run_dir,
+        ignore_patterns=list(RUN_IGNORE_PATTERNS),
+        commit_message=f"Upload run {run_dir.name}",
+    )
