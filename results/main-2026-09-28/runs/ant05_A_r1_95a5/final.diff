+import asyncio
+import json
+
+import httpx2
+from anthropic import AsyncAnthropic
+
+from app import worker
+
+
+def _client(remaining, seen):
+    def handler(request):
+        seen.append(json.loads(request.content))
+        return httpx2.Response(
+            200,
+            headers={"anthropic-ratelimit-tokens-remaining": str(remaining), "request-id": "req_1"},
+            json={
+                "id": "msg_1", "type": "message", "role": "assistant", "model": worker.MODEL,
+                "content": [{"type": "text", "text": "billing: refund"}],
+                "stop_reason": "end_turn", "stop_sequence": None,
+                "usage": {"input_tokens": 1, "output_tokens": 1},
+            },
+        )
+
+    return AsyncAnthropic(api_key="x", http_client=httpx2.AsyncClient(transport=httpx2.MockTransport(handler)))
+
+
+def test_triage():
+    for remaining, throttle in [(1999, True), (2000, False)]:
+        seen = []
+        out = asyncio.run(worker.triage(_client(remaining, seen), "charged twice"))
+        assert out == {"answer": "billing: refund", "tokens_remaining": remaining,
+                       "request_id": "req_1", "throttle": throttle}
+        assert len(seen) == 1
+        assert seen[0]["max_tokens"] == 512 and seen[0]["system"] == worker.SYSTEM
+        assert seen[0]["messages"] == [{"role": "user", "content": "charged twice"}]
