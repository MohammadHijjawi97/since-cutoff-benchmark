+    """A copy of the orders frame with text trimmed, blanks missing and qty filled."""
+    out = df.copy()
+    for col in out.select_dtypes(include=["object", "string"]).columns:
+        s = out[col]
+        if isinstance(s.dtype, pd.StringDtype):
+            s = s.str.strip()
+            out[col] = s.mask(s == "")
+        else:
+            out[col] = s.map(_clean_text)
