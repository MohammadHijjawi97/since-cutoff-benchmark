--- /dev/null
+++ b/_e2e_kb.py
@@ -0,0 +1,26 @@
+import threading, time
+import uvicorn
+from mcp.server import MCPServer
+from kb.remote import search_remote
+import anyio
+
+seen = []
+srv = MCPServer("kb")
+
+@srv.tool()
+def search(query: str) -> str:
+    return f"Title A for {query}\n\nTitle B\n"
+
+app = srv.streamable_http_app()
+async def wrapped(scope, receive, send):
+    if scope["type"] == "http":
+        seen.append((scope["method"], dict(scope["headers"]).get(b"authorization")))
+    await app(scope, receive, send)
+
+config = uvicorn.Config(wrapped, port=8765, log_level="warning")
+server = uvicorn.Server(config)
+t = threading.Thread(target=server.run, daemon=True); t.start()
+time.sleep(2)
+print(anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "s3cret", "vpn"))
+print(seen)
+server.should_exit = True
