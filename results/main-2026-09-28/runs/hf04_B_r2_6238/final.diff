+import logging
+
+import httpx2
+from huggingface_hub.errors import RepositoryNotFoundError
+
+from app.network import configure_hub_http, current_revision
+
+logging.basicConfig()
+seen = []
+
+
+def h(req):
+    seen.append((dict(req.headers), req.extensions["timeout"]))
+    if "missing" in str(req.url):
+        return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, request=req)
+    if "down" in str(req.url):
+        raise httpx2.ConnectError("boom", request=req)
+    if "slow" in str(req.url):
+        raise httpx2.ReadTimeout("slow", request=req)
+    return httpx2.Response(200, json={"id": "a/b", "sha": "deadbeef"}, request=req)
+
+
+configure_hub_http(httpx2.MockTransport(h))
+print(current_revision("a/b"))
+print(seen[0][0].get("x-acme-job"), seen[0][0].get("user-agent")[:40], seen[0][1])
+print(current_revision("a/down"), current_revision("a/slow"))
+try:
+    current_revision("a/missing")
+except RepositoryNotFoundError as e:
+    print("raised", type(e).__name__)
