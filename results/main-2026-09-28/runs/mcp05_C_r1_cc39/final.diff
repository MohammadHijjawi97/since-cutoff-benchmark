--- /dev/null
+++ b/_kbcheck.py
@@ -0,0 +1,33 @@
+import threading, time, anyio, uvicorn
+from mcp.server import MCPServer
+from kb.remote import search_remote
+
+srv = MCPServer("kb")
+
+
+@srv.tool()
+def search(query: str) -> str:
+    return f"Result for {query}\n\nOnboarding\n"
+
+
+seen = []
+inner = srv.streamable_http_app()
+
+
+async def app(scope, receive, send):
+    if scope["type"] == "http":
+        h = dict(scope["headers"]).get(b"authorization")
+        seen.append((scope["method"], h))
+        if h != b"Bearer s3cret":
+            await send({"type": "http.response.start", "status": 401, "headers": []})
+            await send({"type": "http.response.body", "body": b""})
+            return
+    await inner(scope, receive, send)
+
+
+s = uvicorn.Server(uvicorn.Config(app, port=8765, log_level="warning"))
+threading.Thread(target=s.run, daemon=True).start()
+time.sleep(1.5)
+print(anyio.run(search_remote, "http://127.0.0.1:8765/mcp", "s3cret", "keys"))
+print(seen)
+s.should_exit = True
