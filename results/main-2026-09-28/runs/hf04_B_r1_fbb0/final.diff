+import logging, httpx2
+from huggingface_hub.utils import get_session
+from huggingface_hub.errors import RepositoryNotFoundError
+from app.network import configure_hub_http, current_revision
+logging.basicConfig()
+seen = []
+def handler(req):
+    seen.append(req)
+    if "missing" in str(req.url):
+        return httpx2.Response(404, headers={"X-Error-Code": "RepoNotFound"}, json={"error": "nope"})
+    if "down" in str(req.url):
+        raise httpx2.ConnectError("refused", request=req)
+    if "slow" in str(req.url):
+        raise httpx2.ReadTimeout("slow", request=req)
+    return httpx2.Response(200, json={"id": "a/b", "sha": "deadbeef", "_id": "x", "modelId": "a/b"})
+configure_hub_http(transport=httpx2.MockTransport(handler))
+print(current_revision("a/b"))
+r = seen[-1]; print(r.url, r.headers["X-Acme-Job"], r.headers["user-agent"][:40], r.extensions["timeout"])
+print(current_revision("a/down"), current_revision("a/slow"))
+try: current_revision("a/missing")
+except RepositoryNotFoundError as e: print("raised", type(e).__name__)
+print(get_session() is get_session())
