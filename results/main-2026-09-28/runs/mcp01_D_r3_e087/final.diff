+import sys
+
+import anyio
+from mcp import ClientSession, StdioServerParameters
+from mcp.client.stdio import stdio_client
+
+
+async def run():
+    p = StdioServerParameters(command=sys.executable, args=["-m", "app.server"])
+    async with stdio_client(p) as (r, w):
+        async with ClientSession(r, w) as s:
+            await s.initialize()
+            names = sorted(t.name for t in (await s.list_tools()).tools)
+            a = await s.call_tool("add_note", {"title": "x", "body": "one two  three"})
+            b = await s.call_tool("word_count", {"title": "x"})
+            c = await s.call_tool("word_count", {"title": "nope"})
+            return names, a, b, c
+
+
+def test_e2e():
+    names, a, b, c = anyio.run(run)
+    print(names, a, b, c, sep="\n")
+    assert names == ["add_note", "word_count"]
+    assert a.content[0].text == "saved x" and not a.is_error
+    assert b.content[0].text == "3" and not b.is_error
+    assert c.is_error and "no such note" in c.content[0].text
